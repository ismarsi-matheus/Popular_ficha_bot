function ExcluirPeca(idLinha) {
    swal({
        title: "Você tem certeza?",
        text: "Essa peça será removida da ordem.",
        icon: "warning",
        buttons: true
    }).then((willDelete) => {
        if (willDelete) {

            $.ajax({
                url: "/PecasOrdem/ExcluirPecaDaOrdem/" + idLinha,
                type: "PUT",
                success: function (response) {
                    if (response.erro) {
                        swal("Ops!", response.mensagem, "error");
                    } else {
                        MarcarValoresOrdemAlterados();

                        swal("Sucesso!", "A peça foi excluída com sucesso!", "success");
                        ObterPecasDaOrdem();
                    }
                }
            });
        }
    });
}

function AddInput(elmemento, campoDinheiro, campoQuantidade) {
    if (elmemento.getElementsByTagName('input').length > 0) return;

    _valorAntesEdicao = elmemento.innerText.trim();
    elmemento.innerHTML = '';

    var input = document.createElement('input');
    input.setAttribute('type', 'text');
    input.setAttribute('id', 'inputEditando');
    input.setAttribute('class', 'editando');
    input.setAttribute('style', 'width:100%');
    input.setAttribute('onBlur', 'CloseInput(this,' + campoDinheiro + ')');
    input.setAttribute('onkeyup', 'enterVerify(event)');
    elmemento.appendChild(input);
    input.focus();

    if (campoDinheiro)
        $('#inputEditando').mask('000.000.000.000.000,00', { reverse: true });
    else if (campoQuantidade)
        $('#inputEditando').mask('0000000000');

    $('#inputEditando').val(_valorAntesEdicao);
}

function CloseInput(elmemento, campoDinheiro) {
    var td = elmemento.parentNode;
    var value = elmemento.value;
    td.removeChild(elmemento);
    var cell = tabelaPecas.cell(td);

    if (_valorAntesEdicao !== value && value !== "") {
        let idPecaOrdem = $(td).closest('tr').attr("id");
        let requestURL = '';
        let novoValor = value;

        if (IndexColunaEditando === INDEX_COLUNA_VALOR_A_VISTA) {
            requestURL = '/PecasOrdem/AlterarValorUnitarioPecaDaOrdem';
            novoValor = parseFloat(novoValor.replace(/\./g, '').replace(',', '.'));
        } else if (IndexColunaEditando === INDEX_COLUNA_QUANTIDADE) {
            requestURL = '/PecasOrdem/AlterarQuantidadePecasDaOrdem';
            novoValor = parseInt(novoValor);
        } else if (IndexColunaEditando === INDEX_COLUNA_VALOR_TOTAL) {
            requestURL = '/PecasOrdem/AlterarValorTotalPecaDaOrdem';
            novoValor = parseFloat(novoValor.replace(/\./g, '').replace(',', '.'));
        }
        else if (IndexColunaEditando === INDEX_COLUNA_DESCRICAO_PECA_ORCAMENTO) {
            requestURL = '/PecasOrdem/AlterarObservacaoPecasDaOrdem';
            novoValor = value.trim();
        }
        else if (IndexColunaEditando === INDEX_COLUNA_DESCRICAO) {
            requestURL = '/PecasOrdem/AlterarDescricaoPecasDaOrdem';
            novoValor = value.trim();
        }
        else if (IndexColunaEditando === INDEX_COLUNA_UNIDADE_MEDIDA) {
            requestURL = '/PecasOrdem/AlterarUnidadeMedidaPecasDaOrdem';
            novoValor = value.trim();
        }

        // Resolvido agora, e não no retorno do ajax: IndexColunaEditando é global e já pode estar
        // apontando para outra célula quando a resposta chegar. Descrição, observação e unidade de
        // medida não mexem no total.
        let colunaAlteraValorDaOrdem = IndexColunaEditando === INDEX_COLUNA_VALOR_A_VISTA
            || IndexColunaEditando === INDEX_COLUNA_QUANTIDADE
            || IndexColunaEditando === INDEX_COLUNA_VALOR_TOTAL;

        if (requestURL !== '') {
            td.innerHTML = 'Alterando...';

            $.ajax({
                data: JSON.stringify(novoValor),
                type: "PUT",
                url: requestURL + '/' + idPecaOrdem,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response.erro) {
                        swal("Ops!", response.mensagem, "warning");
                        td.innerHTML = _valorAntesEdicao;
                    } else {
                        if (colunaAlteraValorDaOrdem) MarcarValoresOrdemAlterados();

                        ObterPecasDaOrdem();
                    }
                }
            });
        }
    } else {
        td.innerHTML = _valorAntesEdicao;
    }
}

function MenuOrcamentoAtivo() {
    return window.location.href.includes('FilaOrcamento');
}

function CalculaValorPecaTotal() {
    if (IsNullOrEmpty($('#txtQuantidadePeca').val()) || IsNullOrEmpty($('#txtValorPecaUnitario').val())) return;

    let valorUnitario = FormatarDinheiroParaDecimal($('#txtValorPecaUnitario').val());
    let quantidade = FormatarDinheiroParaDecimal($('#txtQuantidadePeca').val());

    let valorTotalCalculado = FormatDinheiro(FormatarDinheiroParaDecimal(valorUnitario * quantidade));

    PreencherInput('txtValorPeca', 'divValorPeca', valorTotalCalculado);
}

function CalculaValorPecaUnitario() {
    if (IsNullOrEmpty($('#txtQuantidadePeca').val()) || IsNullOrEmpty($('#txtValorPeca').val())) return;

    let valorTotal = FormatarDinheiroParaDecimal($('#txtValorPeca').val());
    let quantidade = FormatarDinheiroParaDecimal($('#txtQuantidadePeca').val());

    let valorUnitarioCalculado = CalcularValorPecaUnitario(valorTotal, quantidade);

    PreencherInput('txtValorPecaUnitario', 'divValorPecaUnitario', valorUnitarioCalculado);
}

function CalcularValorPecaUnitario(valorTotal, quantidade) {
    return FormatDinheiro(FormatarDinheiroParaDecimal(valorTotal / quantidade));
}

function ObterPecasCadastradas() {
    $.ajax({
        dataType: "json",
        type: "GET",
        url: "/Pecas/ObterPecas",
        success: function (dados) {
            if (dados.erro === false) {
                var select = document.getElementById("selectPecasOrdem");

                if (IsNullOrEmpty(select)) return;

                select.options.length = 0;

                $(dados.pecas).each(function (i) {

                    let idPeca = dados.pecas[i].id;
                    let descricao = dados.pecas[i].descricao;
                    let valor = dados.pecas[i].valor_custo;
                    let unidadeMedida = '';
                    let valorVenda = dados.pecas[i].preco_venda;
                    let ehKit = dados.pecas[i].tipo;
                    let ipi = dados.pecas[i].ipi?.aliquota ?? 0;
                    let icms = dados.pecas[i].icms?.aliquota_icms ?? 0;

                    if (!IsNullOrEmpty(dados.pecas[i].cfop_estado))
                        unidadeMedida = dados.pecas[i].cfop_estado;

                    $('<option>').val(valorVenda).text(descricao).attr('id', idPeca).attr(NOME_ATRIBUTO_SELECT_PECA_UNIDADE_DE_MEDIDA, unidadeMedida).attr('valorVenda', valorVenda).attr('ehKit', ehKit).attr('ipi', ipi).attr('icms', icms).appendTo('#selectPecasOrdem');
                });

                $('#selectPecasOrdem').selectpicker('refresh');
            }
        },
        error: function (error) {
            EncerraLoading();
        }
    });
}

function ObterPecasDaOrdem() {
    let idOrdem = $('#txtIdOrdem').val();
    if (IsNullOrEmpty(idOrdem)) {
        return;
    }

    $.ajax({
        dataType: "json",
        type: "GET",
        url: "/PecasOrdem/ObterPecasDaOrdem/" + idOrdem,
        success: function (response) {
            if (response.erro) {
                swal("Ops!", response.mensagem, "warning");
            } else {
                LimparTabela(tabelaPecas);

                let pecas = response.pecas_ordem;
                let valorTotalCusto = 0;
                let valorTotalVenda = 0;
                let valorIPI = 0;
                let valorICMS = 0;

                for (let i = 0; i < pecas.length; i++) {
                    let peca = pecas[i];

                    let checkReutilizarHtml = peca.eh_kit ? '' : CriarCheckBoxReutilizarPeca(
                        peca.id_peca_ordem,
                        peca.reutilizar_peca
                    );
                    let checkClienteForneceHtml = peca.eh_kit ? '' : CriarCheckBoxClienteFornecePeca(
                        peca.id_peca_ordem,
                        peca.cliente_fornece
                    );

                    let valorUnitario = `R$ ${FormatDinheiro(peca.valor_unitario)}`;
                    let valorTotalVendaFormatado = `R$ ${FormatDinheiro(peca.valor_total)}`;

                    const iconeExpandir = peca.eh_kit
                        ? '<i class="fas fa-plus-circle"></i>'
                        : '';

                    let rowNode = tabelaPecas.row
                        .add([
                            iconeExpandir,
                            peca.quantidade,
                            peca.descricao,
                            peca.unidade_de_medida,
                            checkReutilizarHtml,
                            checkClienteForneceHtml,
                            valorUnitario,
                            peca.descricao_orcamento,
                            valorTotalVendaFormatado,
                            CriarFuncoesTabelaPecas(peca.id_peca_ordem),
                            peca.id_peca_lizy,
                            peca.id_peca_ordem,
                            peca.conferido_por,
                            FormataJsonData(peca.data_conferencia),
                            peca.eh_kit,
                            peca.id_kit_vinculado,
                            peca.discriminar_itens_no_faturamento,
                            peca.produtos_kit
                        ])
                        .node();

                    rowNode.id = peca.id_peca_ordem;

                    if (peca.eh_kit) {

                        var permissao = false;

                        $(rowNode).find(`#${PREFIXO_ELEMENTO_CHECKBOX_REUTILIZAR_PECA}${peca.id_peca_ordem}`).removeClass('editavel');
                        $(rowNode).find(`#${PREFIXO_ELEMENTO_CHECKBOX_CLIENTE_FORNECE}${peca.id_peca_ordem}`).removeClass('editavel');

                        ValidarPermissaoOrcamentosLizy(() => {
                            permissao = false;
                        }, () => {
                            permissao = true
                        });

                        if (PaginaAtivaEh('FilaOrcamento')) {
                            if (permissao == true) {
                                $(rowNode).find('td').eq(INDEX_COLUNA_VALOR_TOTAL).removeClass('editavel');
                                $(rowNode).find('td').eq(INDEX_COLUNA_VALOR_A_VISTA).removeClass('editavel');
                            }

                        } else {
                            $(rowNode).find('td').eq(INDEX_COLUNA_VALOR_A_VISTA).removeClass('editavel');
                            $(rowNode).find('td').eq(INDEX_COLUNA_DESCRICAO_PECA_ORCAMENTO).removeClass('editavel');
                        }
                    }

                    if (peca.eh_kit && peca.discriminar_itens_no_faturamento && peca.produtos_kit != null && peca.produtos_kit.length > 0) {

                        peca.produtos_kit.forEach(produto => {

                            valorTotalCusto += parseFloat(produto.valor_total || 0);
                            valorTotalVenda += parseFloat(produto.valor_total || 0);

                            let porcentagemIPI = parseFloat(produto.porcentagem_ipi || 0);
                            let porcentagemICMS = parseFloat(produto.porcentagem_icms || 0);
                            valorIPI += (parseFloat(produto.valor_total || 0)) * (porcentagemIPI / 100);
                            valorICMS += (parseFloat(produto.valor_total || 0)) * (porcentagemICMS / 100);
                        });

                    } else {
                        valorTotalCusto += parseFloat(peca.valor_unitario || 0);
                        valorTotalVenda += parseFloat(peca.valor_total || 0);

                        let porcentagemIPI = parseFloat(peca.porcentagem_ipi || 0);
                        valorIPI += (parseFloat(peca.valor_total || 0)) * (porcentagemIPI / 100);

                        let porcentagemICMS = parseFloat(peca.porcentagem_icms || 0);
                        valorICMS += (parseFloat(peca.valor_total || 0)) * (porcentagemICMS / 100);
                    }
                }

                let valorTotalComImposto = valorTotalVenda + valorIPI + valorICMS;

                $('#valorTotalCustosPecas').text(`R$ ${FormatDinheiro(valorTotalCusto)}`);
                $('#valorTotalPecas').text(`R$ ${FormatDinheiro(valorTotalVenda)}`);

                $('#valorProdutos').text(`R$ ${FormatDinheiro(valorTotalVenda)}`);
                $('#valorIPI').text(`R$ ${FormatDinheiro(valorIPI)}`);
                $('#valorICMS').text(`R$ ${FormatDinheiro(valorICMS)}`);
                $('#valorTotalComImposto').text(`R$ ${FormatDinheiro(valorTotalComImposto)}`);

                RenderizarDatatable(tabelaPecas);
                CalcularValorTotalHorasCustoEVenda();
            }
        },
        error: function (error) {
            swal(
                "Erro!",
                "Houve um erro ao buscar as peças. Detalhes: " + error.responseText,
                "error"
            );
        }
    });
}

function AlterarReutilizarPeca(checkbox, idPecaOrdem) {
    let marcado = checkbox.checked;

    if (marcado) {
        swal({
            title: "Reutilizar Peça?",
            text: "Ao marcar essa opção, o valor unitário e o valor total da peça serão zerados. Deseja continuar?",
            icon: "warning",
            buttons: ["Cancelar", "Sim"],
            dangerMode: true,
        }).then(function (confirmado) {
            if (confirmado) {
                atualizarCheckBoxReutilizar(idPecaOrdem, true, checkbox);
            } else {
                checkbox.checked = false;
            }
        });
    } else {
        atualizarCheckBoxReutilizar(idPecaOrdem, false, checkbox);
    }
}

