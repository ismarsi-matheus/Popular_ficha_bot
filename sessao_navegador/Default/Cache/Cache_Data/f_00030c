$('#tabelaPecas tbody').on('click', 'td.details-control', function () {
    var tr = $(this).closest('tr');
    var row = tabelaPecas.row(tr);
    var icon = $(this).find('i');

    if (icon.length === 0) return;

    if (row.child.isShown()) {
        row.child.hide();
        tr.removeClass('shown');
        icon.removeClass('fa-minus-circle').addClass('fa-plus-circle');
    } else {
        row.child(subItensTabela(row.data())).show();
        tr.addClass('shown');
        icon.removeClass('fa-plus-circle').addClass('fa-minus-circle');
    }
});

function subItensTabela(dado) {
    const discriminarItens = dado[16];
    const pecaKit = dado[17];
    let ehOrcamento = false;

    if (PaginaAtivaEh("FilaOrcamento"))
        ehOrcamento = true;

    let html = `
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Quantidade</th>
                    <th>Descrição</th>
                    <th>Un. Medida</th>
                    ${_displayValor ? '<th>Valor Un.</th>' : ''}
                    ${ehOrcamento ? '<th>Desc. Orç.</th>' : ''}
                    ${_displayValor ? '<th>Valor Total</th>' : ''}
                    <th>Funções</th>
                </tr>
            </thead>
            <tbody>
    `;

    pecaKit.forEach(peca => {
        html += `
            <tr>
                <td>${peca.quantidade}</td>
                <td>${peca.descricao}</td>
                <td>${peca.unidade_de_medida}</td>
                ${_displayValor ? `<td>R$ ${FormatDinheiro(peca.valor_unitario)}</td>` : ''}
                ${ehOrcamento ? `<td>${peca.descricao_orcamento || ''}</td>` : ''}
                ${_displayValor ? `<td>R$ ${FormatDinheiro(peca.valor_total)}</td>` : ''}
                <td>${CriarFuncoesTabelaPecas(peca.id_peca_ordem, discriminarItens)}</td>
           </tr>
        `;
    });

    html += `</tbody></table>`;
    return html;
}

