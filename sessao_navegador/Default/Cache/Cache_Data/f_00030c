function atualizarCheckBoxReutilizar(idPecaOrdem, marcado, checkbox) {
    $.ajax({
        url: '/PecasOrdem/AlterarCheckBoxReutilizarPecaPecasDaOrdem/' + idPecaOrdem,
        type: 'PUT',
        data: JSON.stringify(marcado),
        contentType: 'application/json; charset=utf-8',
        dataType: 'json',
        success: function (response) {
            if (response.erro) {
                swal("Erro", response.mensagem, "warning");
                checkbox.checked = !marcado;
            } else {
                MarcarValoresOrdemAlterados();

                ObterPecasDaOrdem();
            }
        },
        error: function () {
            swal("Erro", "Não foi possível atualizar a peça.", "error");
            checkbox.checked = !marcado;
        }
    });
}

