function BuscarOrdemParaPreencherEtiqueta() {

    let numeroOrdem = ObterValorInput('txtNumeroOrdemEtiqueta');

    var idTipoOrdem = $('#selectTipoOrdemEtiqueta option:selected').val();

    if (IsNullOrEmpty(idTipoOrdem)) idTipoOrdem = 0;

    $.ajax({
        dataType: "json",
        data: {
            numeroOrdem: numeroOrdem,
            idTipoOrdem: idTipoOrdem
        },
        type: "GET",
        url: "/Ordem/ObterOrdemImpressaoEtiqueta",
        success: function (response) {

            if (response.erro) swal('Atenção', response.mensagem, 'error');
            else if (response.ordem.id_ordem > 0) _idOrdemImpressaoEtiqueta = response.ordem.id_ordem;
        }
    });
}

