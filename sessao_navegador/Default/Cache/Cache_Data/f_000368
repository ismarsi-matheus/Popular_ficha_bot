    if (mensagem.tipo === 'loginlizy') {
        this.LoginLizy(mensagem.id, mensagem.id_lizy, mensagem.email, mensagem.permissoes)
    }
});

function LoginLizy(idUsuarioMPM, idLizy, email, permissoes) {
    localStorage.setItem("idUsuario", idUsuarioMPM);
    localStorage.setItem("idLizy", idLizy);
    localStorage.setItem("email", email);
    localStorage.setItem("permissoesLizy", permissoes);
}

var tentativasLizyPermissao = 0;

function ValidarPermissaoOrcamentosLizy(callBackSemPermissao, callBackComPermissao = null) {

    if (tentativasLizyPermissao >= 10) {
        callBackSemPermissao();
        return;
    }

    let permissoes = localStorage.getItem('permissoesLizy');

    if (permissoes == null) {

        setTimeout(() => {
            tentativasLizyPermissao += 1;
            ValidarPermissaoOrcamentosLizy(callBackSemPermissao);
        }, 100);

        return;
    }

    let permissoesArray = permissoes.split(',');

    let possuiPermissaoOrcamentos = permissoesArray.find(valor => valor === "menu_comercial_ver_valores");

    if (!possuiPermissaoOrcamentos) {
        callBackSemPermissao();
    }
    else {
        if (callBackComPermissao != null)
            callBackComPermissao();
    }
}

