//Funcoes de busca do CEP
var _idLogradouro = '';
var _idBairro = '';
var _idEstado = '';
var _idCidade = '';

function BuscarCep(valor, idLogradouro, idBairro, idEstado, idCidade) {
    //Nova variável "cep" somente com dígitos.
    var cep = valor.replace(/\D/g, '');

    //Verifica se campo cep possui valor informado.
    if (cep !== "") {
        //Expressão regular para validar o CEP.
        var validacep = /^[0-9]{8}$/;

        //Valida o formato do CEP.
        if (validacep.test(cep)) {
            MostraLoading();

            _idLogradouro = idLogradouro;
            _idBairro = idBairro;
            _idEstado = idEstado;
            _idCidade = idCidade;

            //Cria um elemento javascript.
            var script = document.createElement('script');

            //Sincroniza com o callback.
            script.src = 'https://viacep.com.br/ws/' + cep + '/json/?callback=CallBackCep';

            //Insere script no documento e carrega o conteúdo.
            document.body.appendChild(script);
        }
        else {
            swal("Aviso!", "CEP Invalido.", "warning");
        }
    }
}

function CallBackCep(conteudo) {
    if (!("erro" in conteudo)) {
        $(_idLogradouro).val(conteudo.logradouro.toUpperCase());
        $(_idBairro).val(conteudo.bairro.toUpperCase());
        $(_idEstado).val(conteudo.uf.toUpperCase());
        $(_idCidade).val(conteudo.localidade.toUpperCase());

        $(_idLogradouro).closest("div").addClass("is-filled");
        $(_idBairro).closest("div").addClass("is-filled");
        $(_idEstado).closest("div").addClass("is-filled");
        $(_idCidade).closest("div").addClass("is-filled");
    }
    else {
        swal("Aviso!", "CEP não encontrado.", "error");
        LimpaCamposBuscaCep(true);
    }

    EncerraLoading();
}

function LimpaCamposBuscaCep(limparInputs) {

    if (limparInputs) {
        $(_idLogradouro).val('');
        $(_idBairro).val('');
        $(_idLogradouro).closest("div").removeClass("is-filled");
        $(_idBairro).closest("div").removeClass("is-filled");

        $(_idEstado).selectpicker('val', -1);
        $(_idCidade).selectpicker('val', -1);
    }

    _idLogradouro = '';
    _idBairro = '';
    _idEstado = '';
    _idCidade = '';
}

function CarregarCidadePorEstado() {
    var idEstado = $('#estado option:selected').val();
    $.ajax({
        url: "/CEP/CidadePorEstado/" + idEstado,
        type: "GET",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        error: function (response) {
            swal("Ops!", "Houve um erro ao carregar as cidades. Tente novamente em instantes.", "error");
        },
        success: function (response) {

            if (response.erro) {
                swal("Ops!", "Houve um erro ao carregar as cidades. Tente novamente em instantes.", "error");
            }
            else {
                var select = document.getElementById("cidade");
                select.options.length = 0;

                for (var i = 0; i < response.cidades.length; i++) {
                    select.options[select.options.length] = new Option(response.cidades[i].nome_cidade, response.cidades[i].id_cidade);
                }

                $('#cidade').selectpicker('refresh');
            }
        }
    });
}

