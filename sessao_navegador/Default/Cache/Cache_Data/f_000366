        ObterValorSelectPicker(ID_ELEMENTO_SELECTPICKER_COMPONENTE_EQUIPAMENTO_QUE_SERA_REALIZADO_SERVICO_ORDEM_ADICIONAR_TABELA),
        ObterValorInput(ID_ELEMENTO_VALOR_SERVICO_DA_ORDEM_EDITAR),
        ObterValorInput(ID_ELEMENTO_VALOR_TOTAL),
    );

    RequestAdicionarServicoASerRealizadoSetor(objeto);
}

function ValidarCampos() {

    let descricao = $('#txtDescricaoServicoDaOrdemAdicionarTabela').val();

    if (IsNullOrEmpty(descricao)) {
        swal("Atenção!", "É necessario preencher o campo: Descrição do Serviço!", "warning");
        return true;
    }

    let setor = ObterValorSelectPicker(ID_ELEMENTO_SETOR_REALIZA_SERVICO_ORDEM_EDITAR);

    if (IsNullOrEmpty(setor)) {
        swal("Atenção!", "É necessario selecionar um setor!", "warning");
        return true;
    }

    let quantidade = $(txtQuantidadeServico).val();

    if (IsNullOrEmpty(quantidade)) {
        swal("Atenção!", "É necessario selecionar uma quantidade!", "warning");
        return true;
    }

    return false;
}

function RequestAdicionarServicoASerRealizadoSetor(objeto, buscarServicosDaOrdem = true) {

    $.ajax({
        data: JSON.stringify(objeto),
        type: "POST",
        url: "/ServicosDaOrdem/AdicionarServicoDaOrdem",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (response.erro)
                swal("Ops!", response.mensagem, "warning");
            else {
                if (buscarServicosDaOrdem) {
                    swal("Sucesso", "Adicionado com sucesso", "success");

                    LimparCamposAdicionarServicosDaOrdem();
                    ObterServicosDaOrdem();
                    AtualizarValoresOrcamento();
                }
            }
        }
    });
}

function GerarObjetoServicoOrdemASerRealizadoNoSetor(quantidade, descricao, idSetorRealizaServico, observacao, idOrdem,
    idComponenteEquipamentoVaiSerRealizadoServico, valorUnitario, valorTotal) {
    return {
        "quantidade": quantidade,
        "descricao": descricao,
        "id_setor_realiza_servico": idSetorRealizaServico,
        "observacao": observacao,
        "id_servico_da_ordem": 0,
        "id_ordem": idOrdem,
        "data_inicio_trabalho": null,
        "data_fim_trabalho": null,
        "criado_pelo_sistema": 0,
        "prioridade": null,
        "excluido": 0,
        "id_componente_equipamento_vai_ser_realizado_servico": idComponenteEquipamentoVaiSerRealizadoServico,
        "valor_custo": FormatarDinheiroParaDecimal(valorUnitario),
        "valor_venda": FormatarDinheiroParaDecimal(valorTotal)
    };
}

function ExcluirServicoDaOrdem(idServico) {
    swal({
        title: "Você tem certeza que deseja excluir esse Serviço da Ordem?",
        text: "O mesmo possui informações vinculadas e você poderá perdê-las!",
        icon: "warning",
        buttons: true
    })
        .then((willDelete) => {
            if (willDelete) {
                $.ajax({
                    url: "/ServicosDaOrdem/ExcluirServicoDaOrdem/" + idServico,
                    type: "PUT",
                    success: function (response) {

                        if (response.erro) {
                            swal("Ops!", "Houve um erro ao alterar o cliente. Detalhes: " + response.mensagem, "error");
                            HabilitarBotao('btnAlterarCliente', 'Alterar');
                        }
                        else {
                            swal("Sucesso!", "O Serviço da Ordem foi excluído com sucesso!", "success");
                            ObterServicosDaOrdem();
                            AtualizarValoresOrcamento();
                        }
                    }
                })
            }
            else swal("Cancelado!", "Exclusão cancelada!", "error");
        });
}

function CriarFuncoesTabelaServicosDaOrdem(idServico) {
    let htmlFuncoes = `
    <div class="dropdown">
        <button class="btnFuncoes btn-link btn-sm" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="fa fa-ellipsis-h"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in" style="width:230px;">`;

    htmlFuncoes += `<a class="dropdown-item" title="Alterar Serviço" href="javascript:void(0);" onclick="AbrirModalAlterarServicoOrdem(${idServico})">
        Alterar Serviço
        </a>`

    htmlFuncoes += `<a class="dropdown-item text-red" title="Excluir Serviço" href="javascript:void(0);" onclick="ExcluirServicoDaOrdem(${idServico})">
        Excluir Serviço
