function CalcularQuantidadeDiasDeTrabalho(totalHoras) {
    const QUANTIDADE_HORAS_CCONSIDERADAS = 8;

    return Math.ceil(totalHoras / QUANTIDADE_HORAS_CCONSIDERADAS);
}

function AdicionarServicoASerRealizadoSetor() {

    if (ValidarCampos()) {
        return;
    }

    let objeto = GerarObjetoServicoOrdemASerRealizadoNoSetor(
        FormatarDinheiroParaDecimal(ObterValorInput(ID_ELEMENTO_QUANTIDADE_SERVICO_DA_ORDEM_EDITAR)),
        ObterValorInput(ID_ELEMENTO_DESCRICAO_SERVICO_DA_ORDEM_ORDEM_EDITAR),
        ObterValorSelectPicker(ID_ELEMENTO_SETOR_REALIZA_SERVICO_ORDEM_EDITAR),
