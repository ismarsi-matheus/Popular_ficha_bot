function ControlarCamposMotorACouDC(idCategoriaEquipamento, idTipoEquipamento) {

    if (idCategoriaEquipamento !== ID_CATEGORIA_EQUIPAMENTO_MOTORES)
        return;

    var divGrupoFichaMotorAC = $('#groupRow' + ID_GRUPO_FICHA_MOTOR_AC);
    var tituloGrupoFichaMotorAC = $('#titulo-' + ID_GRUPO_FICHA_MOTOR_AC);
    var divGrupoFichaMotorDC = $('#groupRow' + ID_GRUPO_FICHA_MOTOR_DC);
    var tituloGrupoFichaMotorDC = $('#titulo-' + ID_GRUPO_FICHA_MOTOR_DC);

    if (idTipoEquipamento === ID_TIPO_EQUIPAMENTO_MOTOR_AC) {
        tituloGrupoFichaMotorDC.hide();
        divGrupoFichaMotorDC.hide();
    }

    else if (idTipoEquipamento === ID_TIPO_EQUIPAMENTO_MOTOR_DC) {
        tituloGrupoFichaMotorAC.hide();
        divGrupoFichaMotorAC.hide();
    }

    else {
        tituloGrupoFichaMotorDC.hide();
        divGrupoFichaMotorDC.hide();
        tituloGrupoFichaMotorAC.hide();
        divGrupoFichaMotorAC.hide();
    }
}

