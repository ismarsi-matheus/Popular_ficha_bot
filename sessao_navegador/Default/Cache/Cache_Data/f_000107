function ObterCondicoesPagamentoCadastradas() {

    if (!ElementoExiste('selectCondicaoPagamento'))
        return;

    $.ajax({
        dataType: "json",
        type: "GET",
        url: "/FilaOrcamento/ObterCondicoesPagamento",
        success: function (dados) {
            if (dados.erro === false) {
                var select = document.getElementById("selectCondicaoPagamento");

                if (IsNullOrEmpty(select)) return;

                select.options.length = 0;

                $(dados.condicoes).each(function (i) {
                    let id = dados.condicoes[i].id;
                    let descricao = dados.condicoes[i].descricao;

                    $('<option>').val(id).text(descricao).appendTo('#selectCondicaoPagamento');
                });

                $('#selectCondicaoPagamento').selectpicker('refresh');
            }
        },
        error: function (error) {
            EncerraLoading();
        }
    });
}

