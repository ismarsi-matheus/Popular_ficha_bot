function AlterarOrdem() {

    var idOrdem = $('#txtIdOrdem').val();

    DesabilitarBotao('btnAlterarOrdem', 'Salvando . . .');

    var body = CarregarOrdemEdicaoBody();

    if (!ValidarFotosForamCarregadasCorretamente(body)) {
        HabilitarBotao('btnAlterarOrdem', 'Salvar');
        return;
    }

    $.ajax({
        url: "/Ordem/Editar/" + idOrdem,
        type: "PUT",
        data: JSON.stringify(body),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (response.erro) {
                swal("Ops!", "Houve um erro ao alterar a ordem. Detalhes: " + response.mensagem, "error");
                HabilitarBotao('btnAlterarOrdem', 'Salvar');
            }
            else {
                swal("Sucesso!", "A ordem foi alterada com sucesso", "success")
                    .then(okay => {

                         history.back()
                        HabilitarBotao('btnAlterarOrdem', 'Salvar');

                        window.parent.postMessage('ordemEditada', '*');
                    });
            }
        }
    });
}

