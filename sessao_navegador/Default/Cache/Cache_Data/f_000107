function ConfigurarAutoAjusteObservacoesOrcamento() {
    $('#txtObservacoesOrcamento')
        .on('input focus', AjustarAlturaObservacoesOrcamento);

    AjustarAlturaObservacoesOrcamento();
}

function AjustarAlturaObservacoesOrcamento() {
    var textarea = document.getElementById('txtObservacoesOrcamento');

    if (!textarea) return;

    textarea.style.height = 'auto';
    textarea.style.height = textarea.scrollHeight + 'px';
}

function PaginaAtivaEdicaoEhDaMontagem() {
    let str = window.location.href;

    let regex = /FilaAprovados\/EdicaoOrdem\/.*\/35\/1/;

    if (regex.test(str)) {
        return true;
    } else {
        return false;
    }
}

function PaginaAtivaEdicaoEhDoBalanceamento() {
