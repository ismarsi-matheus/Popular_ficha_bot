function CalcularValorTotalVenda(recalcularValorDesconto = true) {

    let vendaTotalOrdem = 0;

    let vendaTotalPecas = ObterValorVendaTotalPecas();
    let vendaTotalServicosExternos = ObterValorTotalVendaServicosExternosOrdem();
    let vendaTotalHorasServico = ObterValorTotalVendaHorasServico();

    vendaTotalOrdem += vendaTotalPecas + vendaTotalHorasServico + vendaTotalServicosExternos;

    PreencherInputIdElementoEValor('txtValorTotalProdutos', FormatDinheiro(vendaTotalPecas));
    PreencherInputIdElementoEValor('txtValorTotalServicos', FormatDinheiro(vendaTotalHorasServico + vendaTotalServicosExternos));

    let valorPecas = vendaTotalPecas;
    let valorServicos = vendaTotalHorasServico + vendaTotalServicosExternos;

    if (!IsNullOrEmpty(ObterValorCampoFormatado('txtValorFinalComDescontoServicos')))
        valorServicos = ObterValorCampoFormatado('txtValorFinalComDescontoServicos');

    if (!IsNullOrEmpty(ObterValorCampoFormatado('txtValorFinalComDescontoProdutos')))
        valorPecas = ObterValorCampoFormatado('txtValorFinalComDescontoProdutos');

    PreencherInputIdElementoEValor('txtValorOrcamento', FormatDinheiro(valorPecas + valorServicos));
    $('#txtValorOrcamento').change();

    if (recalcularValorDesconto) {
        $('#txtValorTotalProdutos').change();
        $('#txtValorTotalServicos').change();
    }
}

