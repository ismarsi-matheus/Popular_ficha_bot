function CalcularValorTotalCusto() {

    let custoTotalOrdem = 0;
    let valorOrcamento = FormatarDinheiroParaDecimal($('#txtValorOrcamento').val());
    let valorDesconto = FormatarDinheiroParaDecimal($('#txtValorDesconto').val());
    let porcentagemValorComissao = FormatarDinheiroParaDecimal($('#txtPorcentagemComissaoVenda').val());

    let custoTotalPecas = ObterCustoTotalPecas();
    let custoTotalServicosExternos = 0;

    if (ElementoExiste('tabelaServicosExternosDaOrdem'))
        custoTotalServicosExternos = ObterValorTotalServicosExternosOrdem();

    let custoTotalHorasServico = 0;

    if (ElementoExiste('tabelaServicosDaOrdem'))
        custoTotalHorasServico = ObterValorTotalCustoHorasServico();

    if (valorDesconto) {
        var valorComissaoVenda = (valorDesconto / 100) * porcentagemValorComissao;
    } else {
        var valorComissaoVenda = (valorOrcamento / 100) * porcentagemValorComissao;
    }

    custoTotalOrdem += custoTotalPecas + valorComissaoVenda + custoTotalServicosExternos + custoTotalHorasServico;

    PreencherInput('txtValorTotalCusto', 'divValorTotalCusto', FormatDinheiro(custoTotalOrdem));
    PreencherInput('txtValorComissaoVenda', 'divValorComissaoVenda', FormatDinheiro(valorComissaoVenda));
}

