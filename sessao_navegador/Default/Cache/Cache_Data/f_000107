function VerificaCamposPreenchidos() {
    $('input[type="text"]').each(function () {

        if ($(this).attr('id') !== 'txtFabricante' &&
            $(this).attr('id') !== 'txtTipoEquipamento' &&
            $(this).attr('id') !== 'txtModelo' &&
            $(this).attr('id') !== 'txtAnalisePreliminar' &&
            $(this).attr('id') !== 'txt5429' &&
            $(this).attr('id') !== 'txt5430' &&
            $(this).attr('id') !== 'txt5431' &&
            $(this).attr('id') !== 'txt7253' &&
            $(this).val() !== '') {
            $(this).prop('disabled', true);
        }
    });

    $('input[type="checkbox"]').each(function () {
        var marcado = $(this).prop('checked');
        if (marcado) {
            $(this).prop('disabled', true);
        }
    });

    $('.selectpicker').each(function () {
        if ($(this).find('option:selected').length > 0) {
            $(this).prop('disabled', true);
        }
    });

    $('textarea').each(function () {
        if ($(this).val().trim() !== '') {
            $(this).prop('disabled', true);
        }
    });
}

