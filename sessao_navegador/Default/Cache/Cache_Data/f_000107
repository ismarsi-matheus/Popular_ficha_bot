$('#uploadArquivoPropostaComercialOrdem').on('change', function (e) {

    $("#labelUploadArquivoPropostaComercialOrdem").html("Salvando . . .");

    var files = e.target.files;

    if (files.length <= 0)
        return;

    if (window.FormData === undefined) {
        swal("Ops!", "Houve um erro ao fazer o upload do arquivo", "error");
        $("#labelUploadArquivoPropostaComercialOrdem").html("Fazer upload do arquivo da proposta");
        return;
    }

    var data = new FormData();
    for (var x = 0; x < files.length; x++) {
        data.append("file" + x, files[x]);
    }

    $.ajax({
        url: "/Arquivos/UploadArquivo/",
        type: "POST",
        contentType: false,
        processData: false,
        data: data,
        success: function (response) {
            if (response.erro) {
                swal("Ops!", "Houve um erro ao fazer o upload da proposta. Detalhes: " + response.mensagem, "error");
                $("#labelUploadArquivoPropostaComercialOrdem").html("Fazer upload do arquivo da proposta");
            }
            else {
                AdicionarArquivoPropostaComercialOrdem($('#txtIdOrdem').val(), response.caminhoArquivo);
            }
        }
    });
});

