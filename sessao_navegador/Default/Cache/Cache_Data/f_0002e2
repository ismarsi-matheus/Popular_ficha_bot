function AlterarMargemLucroGeral() {
    let rowsData = tabelaPecas.rows().data();
    let margemLucroGeral = ObterValorInput('txtValorMargemLucroGeralPecas');

    let margemLucroNumerica = parseFloat(margemLucroGeral.replace(',', '.'));
    if (isNaN(margemLucroNumerica)) {
        return;
    }

    for (let i = 0; i < rowsData.length; i++) {
        let indexLinha = tabelaPecas.row('#' + rowsData[i][INDEX_COLUNA_ID_LINHA]).index();

        tabelaPecas.cell({ row: indexLinha, column: INDEX_COLUNA_MARGEM_LUCRO })
            .data(FormatDinheiro(margemLucroNumerica));
    }

    CalcularValorTotalPecas();
}

function ObterQuantidadeAtualEstoquePecas() {

    let idOrdem = $('#txtIdOrdem').val();

    if (IsNullOrEmpty(idOrdem))
        return;

    $.ajax({
        dataType: "json",
        type: "GET",
        url: "/Pecas/ObterEstoque/" + idOrdem,
        success: function (dados) {
            if (!dados.erro) {

                dados.dados.forEach(item => {
                    let idPecaOrdem = item.item1;
                    let quantidadeAtualEstoque = item.item2;

                    let $row = $('#' + idPecaOrdem);

                    if ($row.length === 0) return;

                    let $cellDescricao = $row.find('td:nth-child(2)');
                    let descricaoAtual = $cellDescricao.html();

                    $cellDescricao.html(descricaoAtual + "<br/>Estoque Atual: " + quantidadeAtualEstoque);

                    let quantidadePecaTexto = $row.find('td:nth-child(1)').text();
                    quantidadePecaTexto = quantidadePecaTexto.replace(',', '.');
                    let quantidadePeca = parseFloat(quantidadePecaTexto);

                    if (isNaN(quantidadePeca)) {
                        quantidadePeca = 0;
                    }

                    if (quantidadePeca > quantidadeAtualEstoque) {
                        $row.addClass('red-row');
                    }
                });
            }
        },
        error: function (error) {
            EncerraLoading();
        }
    });
}

function getValorAntesDoBR(str) {
    if (!str) return "";

    if (str.includes('&lt;br')) {
        // Divide a string no ponto onde aparece "&lt;br"
        const partes = str.split("&lt;br");

        // Retorna apenas a primeira parte (antes do &lt;br), removendo espaços extras
        return partes[0].trim();
    }
    else if (str.includes('<br/>')) {
        // Divide a string no ponto onde aparece "&lt;br"
        const partes = str.split("<br/>");

        // Retorna apenas a primeira parte (antes do &lt;br), removendo espaços extras
        return partes[0].trim();
    }
    else
        return str;
}