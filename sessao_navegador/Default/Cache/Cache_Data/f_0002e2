function AddInput(elmemento, campoDinheiro, campoQuantidade) {
    if (elmemento.getElementsByTagName('input').length > 0) return;

    _valorAntesEdicao = elmemento.innerHTML;
    elmemento.innerHTML = '';

    var input = document.createElement('input');
    input.setAttribute('type', 'text');
    input.setAttribute('id', 'inputEditando');
    input.setAttribute('class', 'editando');
    input.setAttribute('style', 'width:100%');
    input.setAttribute('onBlur', 'CloseInput(this,' + campoDinheiro + ')');
    input.setAttribute('onkeyup', 'enterVerify(event)');
    elmemento.appendChild(input);
    input.focus();

    if (campoQuantidade)
        $('#inputEditando').mask('00000');
    else if (campoDinheiro)
        $('#inputEditando').mask('000000000000000,00', { reverse: true });
    else
        $('#inputEditando').val('');
}

function CloseInput(elmemento, campoDinheiro) {
    var td = elmemento.parentNode;
    var value = elmemento.value;
    td.removeChild(elmemento);
    var cell = tabelaPecas.cell(td);
    if (_valorAntesEdicao !== value && value !== "") {

        if (!campoDinheiro) {
            td.innerHTML = value;
            cell.data(value);
        }
        else {
            var valor = FormatDinheiro(parseFloat(value.replace(',', '.')));

            if (!AlterouValorMargemLucro() && !AlterouQuantidade()) {
                valor = 'R$' + valor;
            }

            td.innerHTML = valor;
            cell.data(valor);
        }

        CalcularValorTotalPecas();
    }
    else td.innerHTML = _valorAntesEdicao;

    _valorAntesEdicao = '';
}

function CalcularValorTotalPecas() {

    let rowsData = tabelaPecas.rows().data();
    let indexes = tabelaPecas.rows().indexes();
    let totalVenda = 0;
    let totalCusto = 0;
    for (var i = 0; i < rowsData.length; i++) {

        let idLinha = rowsData[i][INDEX_COLUNA_ID_LINHA];
        let indexLinha = indexes[i]; // Índice real da linha

        if (idLinha != IDLinhaEditando)
            continue;

        let quantidade = FormatarDinheiroParaDecimal(rowsData[i][_indexColunaQuantidade]);
        let valorUnitario = FormatarDinheiroParaDecimal(rowsData[i][_indexColunaValorUnitario])
        let valorVenda = FormatarDinheiroParaDecimal(rowsData[i][_indexColunaValorVenda]);
        let margemLucro = FormatarDinheiroParaDecimal(rowsData[i][INDEX_COLUNA_MARGEM_LUCRO]);
        let valorTotal = FormatarDinheiroParaDecimal(rowsData[i][INDEX_COLUNA_VALOR_CUSTO_TOTAL]);
        let valorTotalVenda = FormatarDinheiroParaDecimal(rowsData[i][_indexColunaValorVenda]);
        let valorTotalCalculado = FormatarDinheiroParaDecimal(valorUnitario * quantidade);

        let margemLucroCalculada = FormatarDinheiroParaDecimal(valorTotalCalculado * margemLucro);


        if (ObterValorCheckBox(PREFIXO_ELEMENTO_CHECKBOX_CLIENTE_FORNECE + idLinha) || ObterValorCheckBox(PREFIXO_ELEMENTO_CHECKBOX_REUTILIZAR_PECA + idLinha)) {
            tabelaPecas.cell({ row: indexLinha, column: _indexColunaValorUnitario }).data('R$' + FormatDinheiro(0));
            tabelaPecas.cell({ row: indexLinha, column: INDEX_COLUNA_VALOR_CUSTO_TOTAL }).data('R$' + FormatDinheiro(0));
            tabelaPecas.cell({ row: indexLinha, column: _indexColunaValorVenda }).data('R$' + FormatDinheiro(0));
        }

        if (AlterouValorUnitarioOuQuantidade()) {

            if (quantidade > 0 && valorUnitario > 0) {

                if (valorTotalCalculado !== valorTotal) {
                    tabelaPecas.cell({ row: indexLinha, column: INDEX_COLUNA_VALOR_CUSTO_TOTAL }).data('R$' + FormatDinheiro(valorTotalCalculado));
                }
                if (margemLucroCalculada !== valorVenda) {
                    tabelaPecas.cell({ row: indexLinha, column: _indexColunaValorVenda }).data('R$' + FormatDinheiro(margemLucroCalculada));
                }

            }
        }
        else if (AlterouValorTotal()) {
            margemLucroCalculada = FormatarDinheiroParaDecimal(valorTotal * margemLucro);

            if (quantidade > 0 && valorTotal > 0) {
                let valorUnitarioCalculado = FormatarDinheiroParaDecimal(valorTotal / quantidade);

                if (valorUnitarioCalculado !== valorUnitario) {
                    tabelaPecas.cell({ row: indexLinha, column: _indexColunaValorUnitario }).data('R$' + FormatDinheiro(valorUnitarioCalculado * margemLucro));
                }
            }

            if (margemLucroCalculada !== valorVenda) {
                tabelaPecas.cell({ row: indexLinha, column: _indexColunaValorVenda }).data('R$' + FormatDinheiro(margemLucroCalculada));
            }
        }
        else if (AlterouValorTotalVenda()) {
            margemLucroCalculada = CalcularMargemLucro(valorTotalVenda, valorTotalCalculado);
            tabelaPecas.cell({ row: indexLinha, column: INDEX_COLUNA_MARGEM_LUCRO }).data(FormatDinheiro(margemLucroCalculada));
        }

        if (margemLucro > 0 && AlterouValorMargemLucro()) {
            if (margemLucroCalculada !== valorVenda && margemLucroCalculada > 0) {
                tabelaPecas.cell({ row: indexLinha, column: _indexColunaValorVenda }).data('R$' + FormatDinheiro(margemLucroCalculada));
            }
        }

    }

    RenderizarDatatable(tabelaPecas);

    CalcularValorTotalCusto();
    CalcularValorTotalVenda();
}

function AlterouQuantidade() {
    return (IndexColunaEditando === _indexColunaQuantidade)
}

function AlterouValorUnitarioOuQuantidade() {
    return (AlterouQuantidade() || IndexColunaEditando === _indexColunaValorUnitario)
}

function AlterouValorMargemLucro() {
    return (IndexColunaEditando === INDEX_COLUNA_MARGEM_LUCRO)
}

function AlterouValorTotal() {
    return (IndexColunaEditando === INDEX_COLUNA_VALOR_CUSTO_TOTAL)
}

function AlterouValorTotalVenda() {
    return (IndexColunaEditando === _indexColunaValorVenda)
}

function MenuOrcamentoAtivo() {
    return window.location.href.includes('FilaOrcamento');
}

function CalculaValorPecaTotal() {
    if (IsNullOrEmpty($('#txtQuantidadePeca').val()) || IsNullOrEmpty($('#txtValorPecaUnitario').val())) return;

    let valorUnitario = FormatarDinheiroParaDecimal($('#txtValorPecaUnitario').val());
    let quantidade = FormatarDinheiroParaDecimal($('#txtQuantidadePeca').val());

    let valorTotalCalculado = FormatDinheiro(FormatarDinheiroParaDecimal(valorUnitario * quantidade));

    PreencherInput('txtValorPeca', 'divValorPeca', valorTotalCalculado);
}

function CalculaValorValorVenda(valorVendaInicial) {
    if (IsNullOrEmpty($('#txtQuantidadePeca').val()) || valorVendaInicial === null) return;

    let quantidade = FormatarDinheiroParaDecimal($('#txtQuantidadePeca').val());
    let valorTotalVenda = FormatDinheiro(FormatarDinheiroParaDecimal(valorVendaInicial * quantidade));

    PreencherInput('txtValorVenda', 'divValorVenda', valorTotalVenda);
}

function CalculaValorPecaUnitario() {
    if (IsNullOrEmpty($('#txtQuantidadePeca').val()) || IsNullOrEmpty($('#txtValorPeca').val())) return;

    let valorTotal = FormatarDinheiroParaDecimal($('#txtValorPeca').val());
    let quantidade = FormatarDinheiroParaDecimal($('#txtQuantidadePeca').val());

    let valorUnitarioCalculado = CalcularValorPecaUnitario(valorTotal, quantidade);

    PreencherInput('txtValorPecaUnitario', 'divValorPecaUnitario', valorUnitarioCalculado);
}

function CalcularValorPecaUnitario(valorTotal, quantidade) {
    return FormatDinheiro(FormatarDinheiroParaDecimal(valorTotal / quantidade));
}

function ObterPecasCadastradas() {
    $.ajax({
        dataType: "json",
        type: "GET",
        url: "/Pecas/ObterPecas",
        success: function (dados) {
            if (dados.erro === false) {
                var select = document.getElementById("selectPecasOrdem");

                if (IsNullOrEmpty(select)) return;

                select.options.length = 0;

                $(dados.pecas).each(function (i) {
                    let idPeca = dados.pecas[i].id;
                    let descricao = dados.pecas[i].codigo + " - " + dados.pecas[i].descricao;
                    let valor = dados.pecas[i].valor_custo;
                    let unidadeMedida = '';
                    let valorVenda = dados.pecas[i].preco_venda;
                    let token1 = dados.pecas[i].prazo_minimo;
                    let token2 = dados.pecas[i].prazo_validade;
                    let qtdEstoqueAtual = dados.pecas[i].quantidade_estoque_atual;

                    if (!IsNullOrEmpty(dados.pecas[i].cfop_estado))
                        unidadeMedida = dados.pecas[i].cfop_estado;

                    let dataTokens = token1 + ' ' + token2;

                    let tamanhoMaximo = 150;

                    if (window.innerWidth <= 800)
                        tamanhoMaximo = 80;
                    else if (window.innerWidth <= 1050)
                        tamanhoMaximo = 110;

                    if (descricao.length > tamanhoMaximo) {
                        descricao = descricao.substring(0, tamanhoMaximo - 3) + '...';
                    }

                    $('<option>').val(valor).text(descricao).attr('id', idPeca).attr(NOME_ATRIBUTO_SELECT_PECA_UNIDADE_DE_MEDIDA, unidadeMedida)
                        .attr('valorVenda', valorVenda).attr('data-tokens', dataTokens).attr('quantidadeEstoqueAtual', qtdEstoqueAtual).appendTo('#selectPecasOrdem');
                });

                $('#selectPecasOrdem').selectpicker('refresh');
            }
        },
        error: function (error) {
            EncerraLoading();
        }
    });
}

function ObterCustoTotalPecas() {
    if (!$.fn.DataTable.isDataTable('#tabelaPecas')) return;

