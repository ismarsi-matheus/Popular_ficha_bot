function AdicionarPeca() {
    DesabilitarBotao('btnAdicionarPeca', 'Adicionando . . .');

    if (!ValidarCamposPecaOrdem()) {
        HabilitarBotao('btnAdicionarPeca', 'Adicionar');
        return;
    }
    _idColunaAtual = Math.floor(Math.random() * 1000);
    InserirPecaNaTabela();

    CalcularValorTotalCusto();
}

function ValidarCamposPecaOrdem() {
    if (IsNullOrEmpty($('#txtQuantidadePeca').val())) return MostrarModalErro('quantidade', 'txtQuantidadePeca');
    if ($('#txtQuantidadePeca').val() == '0' || $('#txtQuantidadePeca').val() == '0,00' || $('#txtQuantidadePeca').val() == '0,0'|| $('#txtQuantidadePeca').val() == '0.00' || $('#txtQuantidadePeca').val() == '0.0' ) return MostrarModalErro('quantidade', 'txtQuantidadePeca');
    if (IsNullOrEmpty($('#selectPecasOrdem option:selected').text())) return MostrarModalErroSelect('descrição', 'selectPecasOrdem');

    return true;
}

function VerificaValorDeVenda(valorVenda, valorUnitario) {
    if (valorVenda === 0 || valorVenda === null)
        return valorUnitario;
    else
        return valorVenda;
}

function CalcularMargemLucro(valorVenda, valorUnitarioPeca) {

    if (valorVenda == 0 && valorUnitarioPeca == 0)
        return 0;

    if (valorVenda === 0)
        valorVenda = valorUnitarioPeca;

    var margemLucro = valorVenda / valorUnitarioPeca;

    return margemLucro;
}

function InserirPecaNaTabela() {
    var valorUnitarioPeca = ObterValorCampoFormatado('txtValorPecaUnitario');
    var valorPeca = ObterValorCampoFormatado('txtValorPeca');
    var valorVenda = ObterValorCampoFormatado('txtValorVenda');
    var descricacaoPeca = $('#selectPecasOrdem option:selected').text();
    var idPeca = $('#selectPecasOrdem option:selected').attr('id');
    var unidadeMedida = ObterValorInput('txtUnidadeMedida');

    if ($('#txtQuantidadePeca').val() <= 0) {
        $('#txtQuantidadePeca').val('1');
    }
    var margemLucro = CalcularMargemLucro(+valorVenda, +valorPeca);

    if (IsNullOrEmpty(valorUnitarioPeca))
        valorUnitarioPeca = 0;

    if (IsNullOrEmpty(valorPeca))
        valorPeca = 0;

    if (IsNullOrEmpty(valorVenda))
        valorVenda = valorPeca;

    if (IsNullOrEmpty(unidadeMedida))
        unidadeMedida = "UN";

    let quantidade = $('#txtQuantidadePeca').val();

    let quantidadeAtualEstoque = $('#selectPecasOrdem option:selected').attr('quantidadeEstoqueAtual');

    let descricaoPecaoOrcamento = descricacaoPeca.split(" ")[0];

    if (descricacaoPeca.split(" ").length >= 3)
        descricaoPecaoOrcamento = descricacaoPeca.split(" ")[2]

    tabelaPecas.row.add([
        quantidade,
        descricacaoPeca + "<br/>Estoque Atual: " + quantidadeAtualEstoque,
        unidadeMedida,
        CriarCheckBoxReutilizarPeca(_idColunaAtual),
        CriarCheckBoxClienteFornecePeca(_idColunaAtual),
        'R$' + FormatDinheiro(valorUnitarioPeca),
        'R$' + FormatDinheiro(+valorPeca),
        FormatDinheiro(+margemLucro),
        descricaoPecaoOrcamento,
        'R$' + FormatDinheiro(VerificaValorDeVenda(valorVenda, valorPeca)),
        CriarFuncoesTabelaPecas(_idColunaAtual),
        idPeca,
        _idColunaAtual,
        '',
        ''
    ]).node().id = _idColunaAtual;

    if (quantidade > quantidadeAtualEstoque) {
        let row = tabelaPecas.row('#' + _idColunaAtual).node();

        $(row).addClass('red-row');
    }

    RenderizarDatatable(tabelaPecas);

    LimparCamposPeca();

    if (!IsNullOrEmpty(valorPeca)) CalcularValorTotalPecas();

    HabilitarBotao('btnAdicionarPeca', 'Adicionar');
}

function calcularMarkup(valorCusto, valorVenda) {
    // Evita divisão por zero e custo = 0
    if (valorCusto === 0) {
        return 0;
    }

    return (valorVenda / valorCusto).toFixed(2);
}

