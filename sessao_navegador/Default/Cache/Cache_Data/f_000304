});

var CampoEditandoServicoOrdem = '';
var IDServicoOrdemEditandoNaTabela = 0;

$('#tabelaServicosDaOrdem tbody').on('click', 'td.editavel', function () {
    CampoEditandoServicoOrdem = $(this).attr(DATA_ATTRIBUTE_CAMPO_SERVICO_ORDEM);

    // Sem permissão de ver valores a coluna de valor fica oculta, mas a guarda evita
    // que um clique nela chegue a gravar algo.
    if (CampoEditandoServicoOrdem === CAMPO_VALOR_CUSTO_SERVICO_ORDEM && usuarioTemPermissao != true) return;

    let colunaEhCampoHora = CampoEditandoServicoOrdem === CAMPO_QUANTIDADE_HORAS_SERVICO_ORDEM;
    let colunaEhCampoValor = CampoEditandoServicoOrdem === CAMPO_VALOR_CUSTO_SERVICO_ORDEM;
    let colunaEhQuantidade = CampoEditandoServicoOrdem === CAMPO_QUANTIDADE_SERVICO_ORDEM;

    IDServicoOrdemEditandoNaTabela = ObterIdServicoDaOrdemDaCelula(this);

    AddInputServicoOrdem(this, colunaEhCampoHora, colunaEhCampoValor, colunaEhQuantidade);
});

