var _quantidadeHorasTodosOsServicosinternosOrdem = "";

function ObterServicosDaOrdem() {
    let idOrdem = $('#txtIdOrdem').val();
    $.ajax({
        dataType: "json",
        type: "GET",
        url: "/ServicosDaOrdem/ObterServicosDaOrdem/" + idOrdem,
        cache: false,
        success: function (response) {

            LimparTabela(tabelaServicosDaOrdem);

            for (let i = 0; i < response.servico_ordem.length; i++) {

                if (IsNullOrEmpty(response.servico_ordem[i].valor_custo))
                    response.servico_ordem[i].quantidade = 1;

                let linhaServico = tabelaServicosDaOrdem.row.add([
                    CriarAlcaOrdenacaoTabelaServicosDaOrdem(),
                    parseInt(response.servico_ordem[i].quantidade),
                    response.servico_ordem[i].descricao,
                    response.servico_ordem[i].setor_descricao,
                    "R$ " + FormatDinheiro(response.servico_ordem[i].valor_custo),
                    "R$ " + FormatDinheiro(response.servico_ordem[i].valor_venda),
                    response.servico_ordem[i].componente_equipamento_descricao,
                    response.servico_ordem[i].observacao,
                    FormataJsonDataHora(response.servico_ordem[i].data_inicio_trabalho),
                    FormataJsonDataHora(response.servico_ordem[i].data_fim_trabalho),
                    CriarFuncoesTabelaServicosDaOrdem(response.servico_ordem[i].id_servico_da_ordem),
                    response.servico_ordem[i].id_setor_realiza_servico,
                    response.servico_ordem[i].id_componente_equipamento_vai_ser_realizado_servico,
                ]).node();

                linhaServico.id = response.servico_ordem[i].id_servico_da_ordem;
                linhaServico.setAttribute(DATA_ATTRIBUTE_ID_SERVICO_ORDEM, response.servico_ordem[i].id_servico_da_ordem);
            }

            let horasPrevistas = response.servico_ordem.map(a => a.quantidade_horas_previstas);

            let totalHoras = horasPrevistas.reduce((acc, time) => acc.add(moment.duration(time)), moment.duration());
            let quantidadeHoras = Math.floor(totalHoras.asHours());

            _quantidadeHorasTodosOsServicosinternosOrdem = [quantidadeHoras, AddZero(totalHoras.minutes())].join(':');

            $('#' + ID_ELEMENTO_LABEL_QUANTIDADE_TOTAL_HORAS_SERVICOS_ORDEM).text(_quantidadeHorasTodosOsServicosinternosOrdem);

            $('#' + ID_ELEMENTO_LABEL_QUANTIDADE_TOTAL_DIAS_SERVICOS_ORDEM).text(CalcularQuantidadeDiasDeTrabalho(quantidadeHoras));

            CalcularValorTotalHorasCustoEVenda();

            RenderizarDatatable(tabelaServicosDaOrdem);
        }
    });
}

function CalcularValorTotalHorasCustoEVenda() {

    if (IsNullOrEmpty(_quantidadeHorasTodosOsServicosinternosOrdem)) return;

    let valorTotalCustoHoras = ObterValorTotalCustoHorasServico();
    let valorTotalVendaHoras = ObterValorTotalVendaHorasServico();

    $('#' + ID_ELEMENTO_LABEL_VALOR_TOTAL_CUSTO_HORA_SERVICOS_ORDEM).text('R$ ' + FormatDinheiro(valorTotalCustoHoras));
    $('#' + ID_ELEMENTO_LABEL_VALOR_TOTAL_VENDA_HORA_SERVICOS_ORDEM).text('R$ ' + FormatDinheiro(valorTotalVendaHoras));

    CalcularValorTotalCusto();
    CalcularValorTotalVenda();

    if (PaginaAtivaEh('FilaOrcamento')) {
        CalcularValorTotalVenda();
    }
}

function ObterValorTotalCustoHorasServico() {

    if (IsNullOrEmpty(_quantidadeHorasTodosOsServicosinternosOrdem)) return;

    let valorCustoHora = FormatarDinheiroParaDecimal(ObterValorInput(ID_ELEMENTO_INPUT_VALOR_CUSTO_HORA_SERVICOS_ORDEM));

    let quantidadeHoras = FormatarDinheiroParaDecimal(_quantidadeHorasTodosOsServicosinternosOrdem.split(':')[0]);
    let quantidadeMinutos = FormatarDinheiroParaDecimal(_quantidadeHorasTodosOsServicosinternosOrdem.split(':')[1]);

    let valorTotalCustoHoras = quantidadeHoras * valorCustoHora;

    valorTotalCustoHoras += (((quantidadeMinutos * 100) / 60) / 100) * valorCustoHora;

    return valorTotalCustoHoras;
}

