function CalcularQuantidadeDiasDeTrabalho(totalHoras) {
    const QUANTIDADE_HORAS_CCONSIDERADAS = 8;

    return Math.ceil(totalHoras / QUANTIDADE_HORAS_CCONSIDERADAS);
}

function AdicionarServicoASerRealizadoSetor() {

    if (ValidarCampos()) {
        return;
    }

    let objeto = GerarObjetoServicoOrdemASerRealizadoNoSetor(
        FormatarDinheiroParaDecimal(ObterValorInput(ID_ELEMENTO_QUANTIDADE_SERVICO_DA_ORDEM_EDITAR)),
        ObterValorInput(ID_ELEMENTO_DESCRICAO_SERVICO_DA_ORDEM_ORDEM_EDITAR),
        ObterValorSelectPicker(ID_ELEMENTO_SETOR_REALIZA_SERVICO_ORDEM_EDITAR),
        ObterValorInput(ID_ELEMENTO_OBSERVACAO_SERVICO_DA_ORDEM_ORDEM_EDITAR),
        ObterValorInput(ID_ORDEM),
        ObterValorSelectPicker(ID_ELEMENTO_SELECTPICKER_COMPONENTE_EQUIPAMENTO_QUE_SERA_REALIZADO_SERVICO_ORDEM_ADICIONAR_TABELA),
        ObterValorInput(ID_ELEMENTO_VALOR_SERVICO_DA_ORDEM_EDITAR),
        ObterValorInput(ID_ELEMENTO_VALOR_TOTAL),
    );

    RequestAdicionarServicoASerRealizadoSetor(objeto);
}

function ValidarCampos() {

    let descricao = $('#txtDescricaoServicoDaOrdemAdicionarTabela').val();

    if (IsNullOrEmpty(descricao)) {
        swal("Atenção!", "É necessario preencher o campo: Descrição do Serviço!", "warning");
        return true;
    }

    let setor = ObterValorSelectPicker(ID_ELEMENTO_SETOR_REALIZA_SERVICO_ORDEM_EDITAR);

    if (IsNullOrEmpty(setor)) {
        swal("Atenção!", "É necessario selecionar um setor!", "warning");
        return true;
    }

    let quantidade = $(txtQuantidadeServico).val();

    if (IsNullOrEmpty(quantidade)) {
        swal("Atenção!", "É necessario selecionar uma quantidade!", "warning");
        return true;
    }

    return false;
}

function RequestAdicionarServicoASerRealizadoSetor(objeto, buscarServicosDaOrdem = true) {

    $.ajax({
        data: JSON.stringify(objeto),
        type: "POST",
        url: "/ServicosDaOrdem/AdicionarServicoDaOrdem",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (response.erro)
                swal("Ops!", response.mensagem, "warning");
            else {
                MarcarValoresOrdemAlterados();

                if (buscarServicosDaOrdem) {
                    swal("Sucesso", "Adicionado com sucesso", "success");

                    LimparCamposAdicionarServicosDaOrdem();
                    ObterServicosDaOrdem();
                }
            }
        }
    });
}

function GerarObjetoServicoOrdemASerRealizadoNoSetor(quantidade, descricao, idSetorRealizaServico, observacao, idOrdem,
    idComponenteEquipamentoVaiSerRealizadoServico, valorUnitario, valorTotal) {
    return {
        "quantidade": quantidade,
        "descricao": descricao,
        "id_setor_realiza_servico": idSetorRealizaServico,
        "observacao": observacao,
        "id_servico_da_ordem": 0,
        "id_ordem": idOrdem,
        "data_inicio_trabalho": null,
        "data_fim_trabalho": null,
        "criado_pelo_sistema": 0,
        "prioridade": null,
        "excluido": 0,
        "id_componente_equipamento_vai_ser_realizado_servico": idComponenteEquipamentoVaiSerRealizadoServico,
        "valor_custo": FormatarDinheiroParaDecimal(valorUnitario),
        "valor_venda": FormatarDinheiroParaDecimal(valorTotal)
    };
}

function ExcluirServicoDaOrdem(idServico) {
    swal({
        title: "Você tem certeza que deseja excluir esse Serviço da Ordem?",
        text: "O mesmo possui informações vinculadas e você poderá perdê-las!",
        icon: "warning",
        buttons: true
    })
        .then((willDelete) => {
            if (willDelete) {
                $.ajax({
                    url: "/ServicosDaOrdem/ExcluirServicoDaOrdem/" + idServico,
                    type: "PUT",
                    success: function (response) {

                        if (response.erro) {
                            swal("Ops!", "Houve um erro ao alterar o cliente. Detalhes: " + response.mensagem, "error");
                            HabilitarBotao('btnAlterarCliente', 'Alterar');
                        }
                        else {
                            MarcarValoresOrdemAlterados();

                            swal("Sucesso!", "O Serviço da Ordem foi excluído com sucesso!", "success");
                            ObterServicosDaOrdem();
                        }
                    }
                })
            }
            else swal("Cancelado!", "Exclusão cancelada!", "error");
        });
}

function CriarFuncoesTabelaServicosDaOrdem(idServico) {
    let htmlFuncoes = `
    <div class="dropdown">
        <button class="btnFuncoes btn-link btn-sm" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="fa fa-ellipsis-h"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in" style="width:230px;">`;

    htmlFuncoes += `<a class="dropdown-item" title="Alterar Serviço" href="javascript:void(0);" onclick="AbrirModalAlterarServicoOrdem(${idServico})">
        Alterar Serviço
        </a>`

    htmlFuncoes += `<a class="dropdown-item text-red" title="Excluir Serviço" href="javascript:void(0);" onclick="ExcluirServicoDaOrdem(${idServico})">
        Excluir Serviço
        </a>`
    htmlFuncoes += `</div></div>`;
    return htmlFuncoes;
}

function GerarServicosDaOrdemBaseadoNosTrabalhosSelecionados() {

    let idOrdem = $('#txtIdOrdem').val();

    let body = CarregarOrdemEdicaoBody();

    $('#labelServicosSendoGerados').show();
    $('#labelGerarServicos').hide();

    $.ajax({
        url: "/ServicosDaOrdem/AlterarServicoDaOrdem/" + idOrdem,
        type: "PUT",
        data: JSON.stringify(body),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (response.erro) {
                swal("Ops!", "Houve um erro ao alterar a ordem. Detalhes: " + response.mensagem, "error");
            }
            else {
                LimparValoresOrdemAlterados();

                ObterServicosDaOrdem();
                swal("Sucesso!", "Serviços gerados com sucesso!", "success");
            }

            $('#labelServicosSendoGerados').hide();
            $('#labelGerarServicos').show();
        }
    });
}

function ObterListaServicosPadroes() {
    $.ajax({
        url: "/EscopoDoServico/ObterServicosPadroes",
        type: "GET",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {

            if (!response.erro) {
                $.each(response.servicos_padroes, function (i, item) {
                    $("#datalistServicosPadroes").append($("<option>").attr('value', item).text(item));
                });
            }
        }
    });
}

function ObterServicosPadroesComBaseDescricao() {
    if (IsNullOrEmpty($('#txtDescricaoServicoDaOrdemAdicionarTabela').val()))
        return;

    $.ajax({
        url: "/EscopoDoServico/ObterServicosPadroesComBaseDescricao",
        type: "GET",
        data: {
            descricao: $('#txtDescricaoServicoDaOrdemAdicionarTabela').val()
        },
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (!response.erro) {

                if (IsNullOrEmpty(response.servico)) return;

                PreencherInputIdElementoEValor(ID_ELEMENTO_VALOR_SERVICO_DA_ORDEM_EDITAR, FormatDinheiro(response.servico.valor));

                CalcularValorTotalServicoAdicionar();

                if (!IsNullOrEmpty(response.servico.id_setor_responsavel_servico_da_ordem_ao_aprovar))
                    UpdateSelectPicker(ID_ELEMENTO_SETOR_REALIZA_SERVICO_ORDEM_EDITAR, response.servico.id_setor_responsavel_servico_da_ordem_ao_aprovar);

                if (!IsNullOrEmpty(response.servico.id_componente_vai_realizar_servico))
                    UpdateSelectPicker(ID_ELEMENTO_SELECTPICKER_COMPONENTE_EQUIPAMENTO_QUE_SERA_REALIZADO_SERVICO_ORDEM_ADICIONAR_TABELA, response.servico.id_componente_vai_realizar_servico);
            }
        }
    });
}

function AddInputServicoOrdem(elmemento, campoEhHoras, campoEhValor, colunaEhQuantidade) {

    console.log(elmemento)
    console.log(campoEhHoras)
    console.log(campoEhValor)
    console.log(colunaEhQuantidade)

    if (elmemento.getElementsByTagName('input').length > 0) return;

    _valorAntesEdicao = elmemento.innerHTML;
    elmemento.innerHTML = '';

    var input = document.createElement('input');
    input.setAttribute('type', 'text');
    input.setAttribute('id', 'inputEditando');
    input.setAttribute('class', 'editando');
    input.setAttribute('style', 'width:100%');
    input.setAttribute('onBlur', 'CloseInputServicoOrdem(this,' + campoEhHoras + ', ' + campoEhValor + ',' + colunaEhQuantidade + ')');
    input.setAttribute('onkeyup', 'enterVerify(event)');
    elmemento.appendChild(input);
    input.focus();
    if (campoEhHoras) $('#inputEditando').mask('000:00', { reverse: true });
    else if (campoEhValor) $('#inputEditando').mask('000.000.000.000.000,00', { reverse: true });
    else if (colunaEhQuantidade) $('#inputEditando').mask('0000000000');

    $('#inputEditando').val('');
}

function CloseInputServicoOrdem(elmemento, campoEhHoras, campoEhValor, colunaEhQuantidades) {
    var td = elmemento.parentNode;
    var value = elmemento.value;
    td.removeChild(elmemento);
    if (_valorAntesEdicao !== value && value !== "") {

        td.innerHTML = 'Alterando...';

        if (campoEhHoras)
            value = ValidarValorHora(value)

        AlterarServicoDaOrdemPelaTabela(value, td, _valorAntesEdicao);
    }

    else td.innerHTML = _valorAntesEdicao;

    _valorAntesEdicao = '';
}

function ValidarValorHora(valorHora) {
    if (valorHora === '' || valorHora === '' || valorHora === null || valorHora === 'NaN') {
        return '';
    }
    else {
        if (!/:/.test(valorHora)) {
            valorHora += ':00';
        }
        //Caso esteja como 14:
        else if (valorHora.length === 3) {
            valorHora += '00';
        }

        return valorHora = valorHora.replace(/^\d{1}:/, '0$&').replace(/:\d{1}$/, '$&0');
    }
}

function AlterarServicoDaOrdemPelaTabela(novoValor, tdTabela, valorSeDerErro) {

    let requestURL = '/ServicosDaOrdem/AlterarObservacaoServicoOrdem';

    if (CampoEditandoServicoOrdem === CAMPO_DESCRICAO_SERVICO_ORDEM)
        requestURL = '/ServicosDaOrdem/AlterarDescricaoServicoDaOrdem';
    else if (CampoEditandoServicoOrdem === CAMPO_QUANTIDADE_SERVICO_ORDEM) {
        requestURL = '/ServicosDaOrdem/AlterarQuantidadeServicoDaOrdem';
        novoValor = FormatarDinheiroParaDecimal(novoValor);
    }
    else if (CampoEditandoServicoOrdem === CAMPO_VALOR_CUSTO_SERVICO_ORDEM) {
        if (usuarioTemPermissao != true) {
            tdTabela.innerHTML = valorSeDerErro;
            return;
        }

        requestURL = '/ServicosDaOrdem/AlterarValorVendaServico';
        novoValor = FormatarDinheiroParaDecimal(novoValor);
    }

    // Resolvido agora, e não no retorno do ajax: CampoEditandoServicoOrdem é global e já pode estar
    // apontando para outra célula quando a resposta chegar. Descrição e observação não mexem no total.
    let campoAlteraValorDaOrdem = CampoEditandoServicoOrdem === CAMPO_QUANTIDADE_SERVICO_ORDEM
        || CampoEditandoServicoOrdem === CAMPO_VALOR_CUSTO_SERVICO_ORDEM;

    $.ajax({
        data: JSON.stringify(novoValor),
        type: "PUT",
        url: requestURL + '/' + IDServicoOrdemEditandoNaTabela,
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (response.erro) {
                swal("Ops!", response.mensagem, "warning");

                tdTabela.innerHTML = valorSeDerErro;
            }
            else {
                if (campoAlteraValorDaOrdem) MarcarValoresOrdemAlterados();

                ObterServicosDaOrdem();
            }
        }
    });
}

function CriarAlcaOrdenacaoTabelaServicosDaOrdem() {
    return '<span class="' + CLASSE_ALCA_ORDENACAO_SERVICO_ORDEM + '" title="Arraste para reordenar o serviço"' +
        ' style="display:block;padding:8px 0;cursor:move">' +
        '   <i class="fas fa-arrows-alt-v" style="font-size:18px"></i>' +
        '</span>';
}

function InicializarOrdenacaoServicosDaOrdem() {

    $('#tabelaServicosDaOrdem tbody').sortable({
        items: '> tr[' + DATA_ATTRIBUTE_ID_SERVICO_ORDEM + ']',
        handle: 'td.' + CLASSE_COLUNA_ORDENACAO_SERVICO_ORDEM,
        axis: 'y',
        opacity: 0.5,
        cursor: 'move',
        helper: FixarLarguraColunasLinhaArrastada,
        update: function () {
            SalvarOrdenacaoServicosDaOrdem();
        }
    });
}

// Sem isso a linha arrastada perde a largura das colunas e fica ilegível durante o arrasto.
function FixarLarguraColunasLinhaArrastada(evento, linhaArrastada) {

    linhaArrastada.children().each(function () {
        $(this).width($(this).width());
    });

    return linhaArrastada;
}

// Com um filtro de busca ativo só parte dos serviços está no DOM, e gravar essa sequência parcial
// deixaria os serviços filtrados sem ordem. Nesse caso o arrasto fica desabilitado.
function AtualizarDisponibilidadeOrdenacaoServicosDaOrdem() {

    let $corpoTabela = $('#tabelaServicosDaOrdem tbody');

    if (!$corpoTabela.hasClass('ui-sortable')) return;

    let filtroAtivo = tabelaServicosDaOrdem.rows({ search: 'applied' }).count() !== tabelaServicosDaOrdem.rows().count();

    $corpoTabela.sortable('option', 'disabled', filtroAtivo);

    $('.' + CLASSE_ALCA_ORDENACAO_SERVICO_ORDEM).toggleClass('d-none', filtroAtivo);

    $('td.' + CLASSE_COLUNA_ORDENACAO_SERVICO_ORDEM).css('cursor', filtroAtivo ? 'default' : 'move');
}

// Lê a sequência de serviços direto das linhas da tabela. Como cada serviço é uma linha, a sequência
// é sempre completa - as colunas escondidas por permissão de ver valores não influenciam.
function ObterSequenciaIdsServicosDaOrdemNaTabela() {

    let idsServicos = [];

    $('#tabelaServicosDaOrdem tbody tr[' + DATA_ATTRIBUTE_ID_SERVICO_ORDEM + ']').each(function () {
        idsServicos.push(parseInt($(this).attr(DATA_ATTRIBUTE_ID_SERVICO_ORDEM)));
    });

    return idsServicos;
}

function SalvarOrdenacaoServicosDaOrdem() {

    let idsServicos = ObterSequenciaIdsServicosDaOrdemNaTabela();

    if (idsServicos.length === 0) return;

    $.ajax({
        type: "PUT",
        url: "/ServicosDaOrdem/AlterarOrdenacaoServicosDaOrdem/" + ObterValorInput(ID_ORDEM),
        data: JSON.stringify(idsServicos),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {

            if (response.erro) swal("Ops!", response.mensagem, "warning");
            else MostrarFeedbackOrdenacaoServicosDaOrdemSalva();

            // Recarrega em qualquer cenário: no sucesso para o DataTable voltar a ficar em sincronia
            // com o DOM, e no erro para reverter a tela para a ordem que está gravada no banco.
            ObterServicosDaOrdem();
        },
        error: function () {
            swal("Ops!", "Não foi possível salvar a nova ordem dos serviços. A ordem anterior foi restaurada.", "warning");

            ObterServicosDaOrdem();
        }
    });
}

function MostrarFeedbackOrdenacaoServicosDaOrdemSalva() {
    $('#labelOrdenacaoServicosDaOrdemSalva').stop(true, true).fadeIn(200).delay(1500).fadeOut(400);
}

function CalcularValorTotalServicoAdicionar() {

    let quantidade = FormatarDinheiroParaDecimal(ObterValorInput(ID_ELEMENTO_QUANTIDADE_SERVICO_DA_ORDEM_EDITAR))
    let valor = FormatarDinheiroParaDecimal(ObterValorInput(ID_ELEMENTO_VALOR_SERVICO_DA_ORDEM_EDITAR))

    if (quantidade > 0 && valor > 0) {
        PreencherInputIdElementoEValor(ID_ELEMENTO_VALOR_TOTAL, "R$ " + FormatDinheiro(quantidade * valor));
    }
}