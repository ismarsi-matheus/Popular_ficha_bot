$(document).ready(function () {

    tabelaServicosDaOrdem = $('#tabelaServicosDaOrdem').DataTable({
        "language": {
            "url": "https://cdn.datatables.net/plug-ins/1.10.16/i18n/Portuguese-Brasil.json"
        },
        "columnDefs": [
            {
                className: "editavel", targets: [INDEX_QUANTIDADE_TABELA_SERVICO_ORDEM,
                    INDEX_DESCRICAO_SERVICO_TABELA_SERVICO_ORDEM,
                    INDEX_OBSERVACAO_TABELA_SERVICO_ORDEM,
                    INDEX_VALOR_CUSTO_TABELA_SERVICO_ORDEM],
                createdCell: function (celula, valorCelula, dadosLinha, indexLinha, indexColuna) {
                    // O campo editado é resolvido pelo data-campo, nunca pela posição da célula:
                    // ao esconder as colunas de valores por permissão os index visíveis mudam.
                    $(celula).attr(DATA_ATTRIBUTE_CAMPO_SERVICO_ORDEM, ObterCampoEditavelDaColuna(indexColuna));
                }
            },
            {
                visible: false, "targets": [INDEX_ID_SETOR_REALIZA_SERVICO_TABELA_SERVICO_ORDEM,
                    INDEX_ID_COMPONENTE_EQUIPAMENTO_SERA_REALIZADO_SERVICO_TABELA_SERVICO_ORDEM]
            },
            { "width": "90px", "targets": [INDEX_FUNCOES_TABELA_SERVICO_ORDEM] },
            {
                "width": "40px", searchable: false, orderable: false,
                className: 'text-center align-middle ' + CLASSE_COLUNA_ORDENACAO_SERVICO_ORDEM,
                "targets": [INDEX_ORDENACAO_TABELA_SERVICO_ORDEM],
                // A célula inteira é a área de arraste, não só o ícone.
                createdCell: function (celula) {
                    $(celula).css({ 'cursor': 'move', 'padding-left': '0', 'padding-right': '0' });
                }
            }
        ],

        responsive: true,
        infoCallback: function (settings) {
            ArmazenarUltimaPaginaSelecionadaTabela(tabelaServicosDaOrdem);
        },
        paging: false,
        // A ordenação exibida é a que está gravada no banco. Ordenar pelo cabeçalho desfaria o arrasto.
        ordering: false,
    });

    InicializarOrdenacaoServicosDaOrdem();

    tabelaServicosDaOrdem.on('draw', function () {
        AtualizarDisponibilidadeOrdenacaoServicosDaOrdem();
    });

    if (MenuOrcamentoAtivo() || PaginaAtivaEh('Analise')) {
        tabelaServicosDaOrdem.column(INDEX_DATA_INICIO_TABELA_SERVICO_ORDEM).visible(false);
        tabelaServicosDaOrdem.column(INDEX_DATA_FIM_TABELA_SERVICO_ORDEM).visible(false);
    }

    tabelaServicosDaOrdem.column(INDEX_DESCRICAO_COMPONENTE_EQUIPAMENTO_SERA_REALIZADO_SERVICO_TABELA_SERVICO_ORDEM).visible(false);

    ObterServicosDaOrdem();
    ObterListaServicosPadroes();

    $('#txtDescricaoServicoDaOrdemAdicionarTabela').flexdatalist({
        "noResultsText": "Nenhum item encontrado",
        searchDelay: 0,
        minLength: 0,
        searchContain: true,
        maxShownResults: 2000
    });

    $("#txtDescricaoServicoDaOrdemAdicionarTabela-flexdatalist").on("blur", function () {
        ObterServicosPadroesComBaseDescricao();
    });
    $('input.flexdatalist').on('select:flexdatalist', function (event, set, options) {
        ObterServicosPadroesComBaseDescricao();
    });

    ValidarPermissaoOrcamentosLizy(() => {

        $('#colDivValorServicoDaOrdemAdicionarTabela').addClass('d-none');
        $('#colDivValorTotalServicoDaOrdemAdicionarTabela').addClass('d-none');

        tabelaServicosDaOrdem.column(INDEX_VALOR_CUSTO_TABELA_SERVICO_ORDEM).visible(false);
        tabelaServicosDaOrdem.column(INDEX_VALOR_VENDA_TABELA_SERVICO_ORDEM).visible(false);

        usuarioTemPermissao = false;
    }, () => {

        $('#colDivValorServicoDaOrdemAdicionarTabela').removeClass('d-none');
        $('#colDivValorTotalServicoDaOrdemAdicionarTabela').removeClass('d-none');

        tabelaServicosDaOrdem.column(INDEX_VALOR_CUSTO_TABELA_SERVICO_ORDEM).visible(true);
        tabelaServicosDaOrdem.column(INDEX_VALOR_VENDA_TABELA_SERVICO_ORDEM).visible(true);

        usuarioTemPermissao = true;
    });

});

let usuarioTemPermissao = false;

$('#buscaTabelaServicosDaOrdem').keyup(function () {
    tabelaServicosDaOrdem.search($(this).val()).draw();
});

