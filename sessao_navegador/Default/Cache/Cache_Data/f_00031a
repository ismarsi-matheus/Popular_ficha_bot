function MostrarCampoOcultado(elemento, mostrarMarcarElemento) {

    let parentDiv = $(elemento).parent('div');

    if (IsNullOrEmpty(parentDiv)) {

        if (mostrarMarcarElemento)
            $(elemento).parent('label').parent('div').parent('div').show();
        else
            $(elemento).parent('label').parent('div').parent('div').hide();
    }
    else {
        if (mostrarMarcarElemento)
            $(elemento).parent('div').show();
        else
            $(elemento).parent('div').hide();
    }
}

