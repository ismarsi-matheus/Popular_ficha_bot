var _listaIDSelectPickers = [];
var _listaIDTitulos = [];

function GerarGrupo(idGrupo, editavel, idPreGrupo, visualizarApenasTituloPreGrupo) {
    if (idPreGrupo > 0) {
        $.ajax({
            dataType: "json",
            type: "GET",
            url: "/GrupoFicha/ObterPreGrupo",
            data: {
                idPreGrupo: idPreGrupo
            },
            success: function (dados) {
                GerarHtmlPreGrupo(dados.preGrupo, visualizarApenasTituloPreGrupo);
            }
        });
    }

    $.ajax({
        dataType: "json",
        type: "GET",
        url: "/CampoFicha/BuscaCamposGrupo",
        data: {
            idGrupo: idGrupo
        },
        success: function (dados) {
            var html = "";
            _listaIDSelectPickers = [];

            if (!dados.erro) {
                $(dados.campos).each(function (i) {
                    html += GerarHtmlCampo(dados.campos[i], editavel);

                });
            }

            $('#groupRow' + idGrupo).html(html);

            for (i = 0; i < _listaIDSelectPickers.length; i++) {
                var idCampoFicha = _listaIDSelectPickers[i];

                BuscaItensSelectPicker(idCampoFicha, "select" + idCampoFicha);
            }

            for (i = 0; i < _listaIDTitulos.length; i++) {
                idCampoFicha = _listaIDTitulos[i];

                BuscaTitulo(idCampoFicha, "titulo" + idCampoFicha);
            }
        },
        error: function (error) {
            EncerraLoading();
        }
    });
}

function GerarHtmlPreGrupo(preGrupo, visualizarApenasTituloPreGrupo) {
    if (IsNullOrEmpty(preGrupo)) return;
    if (IsNullOrEmpty(preGrupo.id_pre_grupo_tabela_referenciada)) return;

    var idValorSelecionado = 0;

    $.ajax({
        dataType: "json",
        type: "GET",
        url: "/GrupoFicha/ObterValorPreGrupo",
        data:
        {
            idOrdem: $('#txtIdOrdem').val(),
            idPreGrupo: preGrupo.id_pre_grupo_tabela_referenciada
        },
        success: function (dados) {
            if (dados.valorExiste) idValorSelecionado = dados.valorPreGrupo.id_selecionado;

            if (visualizarApenasTituloPreGrupo > 0) GerarPreGrupoApenasTitulo(preGrupo, idValorSelecionado);
            else GerarPreGrupoSelectPicker(preGrupo, idValorSelecionado);
        }
    });
}

function GerarPreGrupoApenasTitulo(preGrupo, idValorSelecionado) {

    var html = "";

    if (idValorSelecionado > 0) {
        $.ajax({
            url: "/GrupoFicha/ObterDescricaoSelecionadoPreGrupo/" + idValorSelecionado,
            type: "POST",
            data: JSON.stringify(preGrupo),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (dados) {
                html += GerarHtmlTituloPreGrupo(preGrupo.titulo_selectpicker + " " + FormatarStrng(dados.descricao));
                $('#preGroupRow' + preGrupo.id_pre_grupo_tabela_referenciada).html(html);
            }
        });
    }
    else {
        html += GerarHtmlTituloPreGrupo(preGrupo.titulo_selectpicker);
        $('#preGroupRow' + preGrupo.id_pre_grupo_tabela_referenciada).html(html);
    }
}

function GerarHtmlTituloPreGrupo(titulo) {

    return "<div class='col-md-12'>" +
        " <h3>" + titulo + "</h3>" +
        "</div>";
}

function GerarPreGrupoSelectPicker(preGrupo, idValorSelecionado) {
    if (IsNullOrEmpty(preGrupo.nome_tabela_selectpicker) || IsNullOrEmpty(preGrupo.nome_coluna_id_selectpicker) || IsNullOrEmpty(preGrupo.nome_coluna_descricao_selectpicker)) return;

    var html = "";

    $.ajax({
        dataType: "json",
        type: "GET",
        url: "/GrupoFicha/ObterRegistrosTabelaPreGrupo",
        data:
        {
            nomeTabela: preGrupo.nome_tabela_selectpicker,
