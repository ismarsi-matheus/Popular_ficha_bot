function MostrarBobinasDeAcordoComQuantidade(inputComQuantidade, codigoSubgrupoDasBobinas) {

    let quantidadeBobinas = $(inputComQuantidade).val();

    let inputsBobinas = $("[" + PREFIXO_DATA_ATTRIBUTE_CODIGO_SUBGRUPO_DESCRICAO + "='" + codigoSubgrupoDasBobinas + "']");

    for (let i = 1; i <= 16; i++) {

        let input = inputsBobinas[i - 1];

        if (!IsNullOrEmpty(input)) {

            if (i <= quantidadeBobinas)
                $(input).parent('div').show();
            else
                $(input).parent('div').hide();
        }
    }
}

function AlterarVisibilidadeCamposDoSubGrupo(sender, codigoSubgrupo) {

    let elementosGrupo = $("[" + PREFIXO_DATA_ATTRIBUTE_CODIGO_SUBGRUPO_DESCRICAO + "='" + codigoSubgrupo + "']");

    if (elementosGrupo.length <= 0) return;

    let mostrarElementos = ObterValorCheckBox(sender.id);

    for (let i = 0; i <= elementosGrupo.length; i++) {

        let elemento = elementosGrupo[i];

        if (!IsNullOrEmpty(elemento)) {
            MostrarCampoOcultado(elemento, mostrarElementos)
        }
    }
}

function AlterarVisibilidadeCamposDoGrupo(sender, codigoGrupo) {
    let mostrarGrupo = ObterValorCheckBox(sender.id);

    if (mostrarGrupo) {
        $("#groupRow" + codigoGrupo).show();
        $("#titulo-" + codigoGrupo).show();
    } else {
        $("#groupRow" + codigoGrupo).hide();
        $("#titulo-" + codigoGrupo).hide();
    }
}

function MarcarCheckboxSubConjunto(sender, codigoSubgrupo) {

    let elementosGrupo = $("[" + PREFIXO_DATA_ATTRIBUTE_CODIGO_SUBGRUPO_DESCRICAO + "='" + codigoSubgrupo + "']");

    if (elementosGrupo.length <= 0) return;

    var marcarCheckboxes = false;

    if (ObterValorCheckBox(sender.id)) {
        marcarCheckboxes = true;
    }

    for (let i = 0; i <= elementosGrupo.length; i++) {

        let elemento = elementosGrupo[i];

        if (!IsNullOrEmpty(elemento)) {
            if (marcarCheckboxes) {
                MostrarCampoOcultado(elemento, marcarCheckboxes)
                $(elemento).show();
                MarcarCheckBox(elemento.id, true);
            } else {
                MostrarCampoOcultado(elemento, marcarCheckboxes)
                DesmarcarCheckBox(elemento.id)
            }
        }
    }
}

