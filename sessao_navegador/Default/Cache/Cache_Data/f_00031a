        error: function (response) {
            swal("Ops!", "Houve um erro ao carregar itens da lista. Tente novamente em instantes.", "error");
        },
        success: function (response) {
            if (response.erro) {
                swal("Ops!", "Houve um erro ao carregar  itens da lista. Tente novamente em instantes.", "error");
            }
            else {
                var select = document.getElementById(idSelectPicker);
                select.options.length = 0;

                for (var i = 0; i < response.itens.length; i++)
                    select.options[select.options.length] = new Option(response.itens[i].descricao, response.itens[i].id);

                $('#' + idSelectPicker).selectpicker('refresh');
            }
        }
    });
}

