function MarcarDesmarcarCheckboxConformeSelecao(elementoClicado, listaIdCheckboxASeremMarcados) {

    var marcarCheckboxes = false;

    if (ObterValorCheckBox(elementoClicado.id)) {
        marcarCheckboxes = true;
    }

    for (var i = 0; i < listaIdCheckboxASeremMarcados.length; i++) {

        let idASerMarcado = listaIdCheckboxASeremMarcados[i];

        if (!idASerMarcado.includes('check'))
            idASerMarcado = ObterIdCheckboxVariavel(idASerMarcado);

        $('#' + idASerMarcado).prop('checked', marcarCheckboxes);
        $('#' + idASerMarcado).trigger('change');
    }
}

