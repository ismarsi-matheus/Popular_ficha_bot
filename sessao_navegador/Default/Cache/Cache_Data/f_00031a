$(document).ready(function () {

    setTimeout(EsconderCamposNaoVisiveisCategoriaEquipamento, 1500);
    setTimeout(CriarLinksITS, 1500);
    setTimeout(AlterarImagens, 1500);

    $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {

        $("." + CLASSE_SLICK_CARROUSEL).each(function () {

            if (!$(this).is(":hidden")) {

                if (!$(this).hasClass('slick-initialized')) {

                    var idMomentoFoto = $(this).attr("data-idMomentoFoto");


                    if (idMomentoFoto)
                        BuscarFotosIlimitadasDaOrdem(idMomentoFoto);
                }
            }
        });
    });

    if (PaginaAtivaEh('CriarOrdem')) {
        setTimeout(() => {
            CarregarFotosIlimitadas();
        }, 1000)
    }
});


