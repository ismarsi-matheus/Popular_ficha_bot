function EsconderCamposNaoVisiveisCategoriaEquipamento() {
    let idCategoriaEquipamento = ObterValorInput('txtIdCategoriaEquipamento');

    if (IsNullOrEmpty(idCategoriaEquipamento)) return;

    $('.esconder-campo-categoria-equipamento-' + idCategoriaEquipamento).each(function () {

        if ($(this).is("th") || $(this).is("td") || $(this).is("div")) {

            $(this).addClass('d-none');
        }
        else {
            let parentDiv = $(this).parent('div');

            if (IsNullOrEmpty(parentDiv)) {

                $(this).parent('label').parent('div').parent('div').addClass('d-none');
            }
            else {
                if (parentDiv.attr('class').includes('col-'))
                    parentDiv.addClass('d-none');
                else if (parentDiv.parent('div').attr('class').includes('col-'))
                    parentDiv.parent('div').addClass('d-none');
            }
        }
    });
}

