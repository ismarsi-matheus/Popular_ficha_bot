function CalcularValoresBalanceamento() {

    let valorRaioPacote = FormatarDinheiroParaDecimal(ObterValorInput(ID_ELEMENTO_INPUT_RAIO_PACOTE));
    let valorComprimentoPacote = FormatarDinheiroParaDecimal(ObterValorInput(ID_ELEMENTO_INPUT_COMPRIMENTO_PACOTE));

    if (IsNullOrEmpty(valorRaioPacote) || IsNullOrEmpty(valorComprimentoPacote)) return;
    //Massa Rotor
    let valorMassaRotor = ((valorRaioPacote * valorRaioPacote) * 3.1416 * 7.89 * valorComprimentoPacote) / 1000;
    PreencherInputIdElementoEValor(ID_ELEMENTO_INPUT_MASSA_ROTOR, valorMassaRotor.toFixed(3).replace('.', ','));

    let valorRotacaoNominal = FormatarDinheiroParaDecimal(ObterValorInput(ID_ELEMENTO_INPUT_ROTACAO_NOMINAL));
    let valorClasseQualidadeBalanceamento = FormatarDinheiroParaDecimal(ObterValorInput(ID_ELEMENTO_INPUT_CLASSE_QUALIDADE_BALANCEAMENTO));

    if (IsNullOrEmpty(valorRotacaoNominal) || IsNullOrEmpty(valorClasseQualidadeBalanceamento)) return;

    //Desbalanceamento Residual Admissivel
    let valorDesbalanceamentoResidualAdmissivel = (valorClasseQualidadeBalanceamento * 9549) / valorRotacaoNominal;

    PreencherInputIdElementoEValor(ID_ELEMENTO_INPUT_DESBALANCEAMENTO_RESIDUAL_ADMISSIVEL, valorDesbalanceamentoResidualAdmissivel.toFixed(3).replace('.', ','));

    if (IsNullOrEmpty(valorMassaRotor) || IsNullOrEmpty(valorDesbalanceamentoResidualAdmissivel)) return;

    //Desbalanceamento Residual Admissivel 2
    let valorDesbalanceamentoResidualAdmissivel2 = valorDesbalanceamentoResidualAdmissivel * valorMassaRotor;

    PreencherInputIdElementoEValor(ID_ELEMENTO_INPUT_DESBALANCEAMENTO_RESIDUAL_ADMISSIVEL_2, valorDesbalanceamentoResidualAdmissivel2.toFixed(3).replace('.', ','));

    if (IsNullOrEmpty(valorDesbalanceamentoResidualAdmissivel2)) return;

    //Desbalanceamento Residual Admissivel Por Plano
    let valorDesbalanceamentoResidualAdmissivelPorPlano = valorDesbalanceamentoResidualAdmissivel2 / 2;

    PreencherInputIdElementoEValor(ID_ELEMENTO_INPUT_DESBALANCEAMENTO_RESIDUAL_ADMISSIVEL_POR_PLANO, valorDesbalanceamentoResidualAdmissivelPorPlano.toFixed(3).replace('.', ','));

    if (IsNullOrEmpty(valorDesbalanceamentoResidualAdmissivelPorPlano)) return;

    let valorR1 = FormatarDinheiroParaDecimal(ObterValorInput(ID_ELEMENTO_INPUT_R1));
    let valorR2 = FormatarDinheiroParaDecimal(ObterValorInput(ID_ELEMENTO_INPUT_R2));

    if (IsNullOrEmpty(valorR1) || IsNullOrEmpty(valorR2)) return;

    PreencherInputIdElementoEValor(ID_ELEMENTO_INPUT_TOLERANCIA_PLANO_R1, (valorDesbalanceamentoResidualAdmissivelPorPlano / valorR1).toFixed(2).replace('.', ','));
    PreencherInputIdElementoEValor(ID_ELEMENTO_INPUT_TOLERANCIA_PLANO_R2, (valorDesbalanceamentoResidualAdmissivelPorPlano / valorR2).toFixed(2).replace('.', ','));
}

function redirecionamentoParaLinkMenu() {
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();

            let href = this.getAttribute('href');

            if (IsNullOrEmpty(href) || href === "#") return;

            document.querySelector(href).scrollIntoView({
                behavior: 'smooth'
            });
        });
    });
}

