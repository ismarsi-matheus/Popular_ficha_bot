function DesabilitaCampoDeAcordoComCheckBox(idCheck, idInicio, idFim, idGrupoFicha) {
    var valorCheck = ObterValorCheckBox(idCheck);

    var prefixoID = 'div';

    if (valorCheck) {
        // Ocultar elementos
        for (var i = idInicio; i <= idFim; i++) {
            $('#' + prefixoID + i + '-' + idGrupoFicha).show();
        }
    } else {
        // Exibir elementos
        for (var i = idInicio; i <= idFim; i++) {
            $('#' + prefixoID + i + '-' + idGrupoFicha).hide();
        }
    }
}

