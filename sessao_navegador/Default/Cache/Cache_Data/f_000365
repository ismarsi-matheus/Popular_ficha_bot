    PreencherInputIdElementoEValor('txtValorTotalProdutos', FormatDinheiroInteligente(vendaTotalPecas));
    PreencherInputIdElementoEValor('txtValorTotalServicos', FormatDinheiroInteligente(vendaTotalHorasServico + vendaTotalServicosExternos));

    let valorPecas = vendaTotalPecas;
    let valorServicos = vendaTotalHorasServico + vendaTotalServicosExternos;

    let valorDescontoProdutos = ObterValorCampoFormatado('txtValorFinalComDescontoProdutos');

    if (valorDescontoProdutos !== null && !isNaN(valorDescontoProdutos)) {
        valorPecas = valorDescontoProdutos;
    }

    let valorDescontoServicos = ObterValorCampoFormatado('txtValorFinalComDescontoServicos');

    if (valorDescontoServicos !== null && !isNaN(valorDescontoServicos)) {
        valorServicos = valorDescontoServicos;
    }

    PreencherInputIdElementoEValor('txtValorOrcamento', FormatDinheiroInteligente(valorPecas + valorServicos));
    $('#txtValorOrcamento').change();

    if (recalcularValorDesconto) {
        $('#txtValorTotalProdutos').change();
        $('#txtValorTotalServicos').change();
    }
}

