function GerarBodyValoresOrdem() {

    var body = {
        "valor_produtos": ObterValorDecimalCampoDadosOrdem('#txtValorTotalProdutos'),
        "valor_servicos": ObterValorDecimalCampoDadosOrdem('#txtValorTotalServicos'),
        "valor_desconto_servicos": ObterValorDecimalCampoDadosOrdem('#txtValorDescontoServicos'),
        "valor_desconto_produtos": ObterValorDecimalCampoDadosOrdem('#txtValorDescontoProdutos'),
        "valor_com_desconto_servicos": ObterValorDecimalCampoDadosOrdem('#txtValorFinalComDescontoServicos'),
        "valor_com_desconto_produtos": ObterValorDecimalCampoDadosOrdem('#txtValorFinalComDescontoProdutos'),
        "valor_orcamento": FormatarDinheiroParaDecimal($('#txtValorOrcamento').val())
    };

    return body;
}

function AtualizarValoresOrcamento() {

    if (!PaginaAtivaEh('FilaOrcamento'))
        return;

    setTimeout(() => {

        let idOrdem = $('#txtIdOrdem').val();

        var body = GerarBodyValoresOrdem();

        $.ajax({
            url: "/Ordem/AtualizarValoresOrcamento/" + idOrdem,
            type: "PUT",
            data: JSON.stringify(body),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response.erro) {
                    swal("Ops!", "Erro ao atualizar valores do orçamento. Detalhes: " + response.mensagem, "error");
                }
            },
            error: function () {
                swal("Ops!", "Erro ao comunicar com o servidor ao atualizar valores do orçamento.", "error");
            }
        });

    }, 1000);
}