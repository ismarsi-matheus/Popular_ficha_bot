function AdicionarArquivoPropostaComercialOrdem(idOrdem, caminhoArquivo) {
    swal({
        title: "Atenção",
        text: "Deseja gerar um novo número de revisão para a proposta?",
        icon: "warning",
        buttons: ["Não", "Sim"],
    }).then((acrescentarNumeroRevisao) => {
        if (acrescentarNumeroRevisao) {

            $.ajax({
                url: "/Ordem/GerarNovoNumeroRevisaoOrdem/" + idOrdem,
                type: "PUT",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response.erro) {
                        swal("Ops!", "Houve um erro ao fazer o upload da proposta. Detalhes: " + response.mensagem, "error");
                        $("#labelUploadArquivoPropostaComercialOrdem").html("Fazer upload do arquivo da proposta");
                    }
                    else {
                        PreencherInputIdElementoEValor('txtNumeroRevisao', FormatarDinheiroParaDecimal(ObterValorInput('txtNumeroRevisao')) + 1);
                        RequestAdicionarArquivoPropostaComercialOrdem(idOrdem, caminhoArquivo);
                    }
                }
            });
        }
        else {
            RequestAdicionarArquivoPropostaComercialOrdem(idOrdem, caminhoArquivo);
        }
    });
}

function RequestAdicionarArquivoPropostaComercialOrdem(idOrdem, caminhoArquivo) {
    $.ajax({
        url: "/Relatorio/AdicionarArquivoPropostaComercialOrdem/" + idOrdem,
        type: "POST",
        data: JSON.stringify({
            caminho_arquivo: caminhoArquivo
        }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (response.erro) {
                swal("Ops!", "Houve um erro ao fazer o upload da proposta. Detalhes: " + response.mensagem, "error");
                $("#labelUploadArquivoPropostaComercialOrdem").html("Fazer upload do arquivo da proposta");
            }
            else {
                swal("Sucesso", "Proposta comercial gravada com sucesso", "success");
                $("#labelUploadArquivoPropostaComercialOrdem").html("Fazer upload do arquivo da proposta");
            }
        }
    });
}

function ObterModelosPropostaComercial() {

    let idOrdem = $('#txtIdOrdem').val();

    $.ajax({
        dataType: "json",
        type: "GET",
        url: "/Proposta/ObterModelos/" + idOrdem,
        success: function (dados) {
            if (dados.erro === false) {
                let select = document.getElementById(ID_ELEMENTO_SELECTPICKER_MODELO_PROSPOTA_COMERCIAL_ORDEM);

                if (select == undefined) return;

                select.options.length = 0;

                $('<option disabled=disabled>').val(0).text("Selecione o modelo da proposta comercial").appendTo('#' + ID_ELEMENTO_SELECTPICKER_MODELO_PROSPOTA_COMERCIAL_ORDEM);

                $(dados.modelos).each(function (i) {
                    let id = dados.modelos[i].id_modelo_proposta_comercial;
                    let descricao = dados.modelos[i].descricao;;

                    $('<option>').val(id).text(descricao).appendTo('#' + ID_ELEMENTO_SELECTPICKER_MODELO_PROSPOTA_COMERCIAL_ORDEM);
                });

                $('#' + ID_ELEMENTO_SELECTPICKER_MODELO_PROSPOTA_COMERCIAL_ORDEM).selectpicker('refresh');
            }
        },
        error: function (error) {
            EncerraLoading();
        }
    });
}

