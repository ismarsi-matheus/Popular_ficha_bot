function CalcularValorDescontoPorPorcentagem(idCampoValorTotal, idCampoPorcentagem, idCampoValorDesconto, idCampoValorFinalComDesconto,
    recalcularValoresVenda = true) {

    const porcentagem = FormatarPorcentagem($('#' + idCampoPorcentagem).val());

    const valorTotal = ObterValorCampoFormatado(idCampoValorTotal);

    if (porcentagem == null || isNaN(porcentagem) || valorTotal < 0) {

        PreencherInputIdElementoEValor(idCampoValorDesconto, 0.00);
        PreencherInputIdElementoEValor(idCampoValorFinalComDesconto, 0.00);
        PreencherInputIdElementoEValor(idCampoPorcentagem, 0.00);
        return;
    }

    let valorDesconto = valorTotal * porcentagem / 100;

    const valorTotalComDesconto = valorTotal - valorDesconto;

    valorDesconto = FormatDinheiroInteligente(valorDesconto);

    PreencherInputIdElementoEValor(idCampoValorDesconto, valorDesconto);

    PreencherInputIdElementoEValor(idCampoValorFinalComDesconto, FormatDinheiroInteligente(valorTotalComDesconto));

    CalcularValorTotalVenda(recalcularValoresVenda);
}

function CalcularValorDescontoPorValor(idCampoValorTotal,
    idCampoPorcentagem,
    idCampoValorDesconto,
    idCampoValorFinalComDesconto,
    recalcularValoresVenda = false) {
    // 1) Obter o valor inserido no campo "desconto" (neste caso, é um valor monetário e não porcentagem).
    let valorDesconto = ObterValorCampoFormatado(idCampoValorDesconto);

    let valorTotal = ObterValorCampoFormatado(idCampoValorTotal);

    if (valorDesconto == null || isNaN(valorDesconto) || valorDesconto < 0) {

        PreencherInputIdElementoEValor(idCampoPorcentagem, 0.00);
        PreencherInputIdElementoEValor(idCampoValorFinalComDesconto, 0.00);
        PreencherInputIdElementoEValor(idCampoValorDesconto, 0.00);
        return;
    }

    // 3) Calcular o valor final subtraindo o desconto
    let valorFinalComDesconto = valorTotal - valorDesconto;

    let valorTotalComDesconto = valorTotal - valorFinalComDesconto;

    let valorFinalComDescontoFormatado = FormatDinheiroInteligente(valorFinalComDesconto);

    PreencherInputIdElementoEValor(idCampoValorFinalComDesconto, valorFinalComDescontoFormatado);

    // 7) Por fim, calcula a porcentagem de desconto aplicada:
    let porcentagemDesconto = 0;
    if (valorTotal > 0) {
        porcentagemDesconto = (valorTotalComDesconto / valorTotal) * 100;
    }

    // Formatar a porcentagem. Podemos colocar o símbolo % no final, se desejado.
    let porcentagemDescontoFormatada = porcentagemDesconto
        .toFixed(2)
        .replace('.', ',') + '%';

    // 8) Preencher o campo de porcentagem
    PreencherInputIdElementoEValor(idCampoPorcentagem, porcentagemDescontoFormatada);

    CalcularValorTotalVenda(recalcularValoresVenda);
}

function CalcularDescontoBaseadoNoValorTotalDesconto(idCampoValorTotal,
    idCampoPorcentagem,
    idCampoValorDesconto,
    idCampoValorFinalComDesconto) {

    const campoInput = document.getElementById(idCampoValorFinalComDesconto);

    if (campoInput == null || campoInput.value.trim() === '') {
        return;
    }

    let valorFinalComDesconto = ObterValorCampoFormatado(idCampoValorFinalComDesconto);

    let valorTotal = ObterValorCampoFormatado(idCampoValorTotal);

    if (valorFinalComDesconto > valorTotal)
        return;

    let valorDesconto = valorTotal - valorFinalComDesconto;

    PreencherInputIdElementoEValor(idCampoValorDesconto, FormatDinheiroInteligente(valorDesconto));

    CalcularValorDescontoPorValor(idCampoValorTotal, idCampoPorcentagem, idCampoValorDesconto, idCampoValorFinalComDesconto);

    CalcularValorTotalVenda(true);
}

