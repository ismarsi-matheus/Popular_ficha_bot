function CalcularValorTotalVenda(recalcularValorDesconto = true) {

    let vendaTotalOrdem = 0;

    let vendaTotalPecas = ObterValorVendaTotalPecas();
    let vendaTotalServicosExternos = ObterValorTotalVendaServicosExternosOrdem();
    let vendaTotalHorasServico = ObterValorTotalVendaHorasServico();

