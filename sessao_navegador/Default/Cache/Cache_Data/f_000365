function ObterOrdem(idOrdem) {

    $.ajax({
        dataType: "json",
        type: "GET",
        url: "/Ordem/ObterOrdem/" + idOrdem,
        success: function (response) {

            console.log('response', response);

            if ($(".dados-basicos-ordem-editavel").length > 0) PreencherCamposBasicosOrdemEditaveis(response.ordemViewModel.ordem, response.ordemViewModel.data_aprovacao_ordem);
            else PreencherCamposBasicosOrdem(response.ordemViewModel.ordem, response.ordemViewModel.dados_basicos_ordem, response.ordemViewModel.data_aprovacao_ordem);

            PreencherDadosOrdem(response.ordemViewModel.dados_ordem, response.ordemViewModel.ordem.aguardando_requisicao_cliente_para_dar_andamento,);
            PreencherValoresCamposOrdem(response.ordemViewModel.valores_campos);
            PreencherValoresCamposFotos(response.ordemViewModel.fotos_ordem);

            UpdateSelectPickerMultiplo(ID_ELEMENTO_SELECTPICKER_MODELO_SECOES_ADICIONAIS_PROSPOTA_COMERCIAL_ORDEM, response.ordemViewModel.modelos_secoes_adicionais_proposta_ordem);
            UpdateSelectPickerMultiplo(ID_ELEMENTO_SELECTPICKER_USUARIO_MODELO_PROPOSTA_COMERCIAL, response.ordemViewModel.escopo_comercial_ordem);

            //ExecutarFuncoesBlurCamposInputs();
            //ExecutarFuncoesOnChangeCamposCheckbox();
            CarregarFotosIlimitadas();
            FinalizarCarregando();
        }
    });
}

