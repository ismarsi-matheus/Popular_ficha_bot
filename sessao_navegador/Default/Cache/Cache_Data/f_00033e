            else if (response.ordens == 1) RedirecionarVisualizarOrdemBuscar(response.ordens);
            else MostrarModalComOrdens(response.ordens);
        }
    });
}

function RedirecionarVisualizarOrdemBuscar(idOrdem) {
    $.ajax({
        dataType: "json",
        data: {
            idOrdem: idOrdem,
        },
        type: "GET",
        url: "/Ordem/ObterFilaAtualOrdem",
        success: function (response) {
            if (response.erro) swal('Atenção', 'Ordem não encontrada', 'warning');
            else {
                if (IsNullOrEmpty(response.fila)) window.location = '/FilaFinalizados/VisualizacaoOrdem/' + idOrdem;
                else if (response.fila.id_tipo_fila == 1) window.location = '/FilaAnalise/EdicaoOrdem/' + idOrdem + '/0';
                else if (response.fila.id_tipo_fila == 2) window.location = '/FilaOrcamento/AlteracaoOrcamento/' + idOrdem;
                else if (response.fila.id_tipo_fila == 3) window.location = '/FilaAprovados/EdicaoOrdem/' + idOrdem + '/0';
                else if (response.fila.id_tipo_fila == 4) window.location = '/FilaNaoAprovados/EdicaoOrdem/' + idOrdem;
                else if (response.fila.id_tipo_fila == 5) window.location = '/FilaExpedicao/EdicaoOrdem/' + idOrdem;
                else if (response.fila.id_tipo_fila == 6) window.location = '/FilaFaturamento/VisualizacaoOrdem/' + idOrdem;        
            }
        }
    });
}

function MostrarModalComOrdens(ordens) {
    AlterarTituloModalOrdens();

    LimparTabela(tabelaLocalizarOrdem);
    CriarEventoTabelaLocalizarOrdem();

    for (var i = 0; i < ordens.length; i++) {

        tabelaLocalizarOrdem.row.add([
            ordens[i].tipo_ordem,
            ordens[i].cliente,
            ordens[i].numero_ordem,
            ordens[i].equipamento,
            ordens[i].valor_ordem
        ]).node().id = ordens[i].id_ordem;
    }

    tabelaLocalizarOrdem.draw();
    $('#modal-localizar-ordem').modal('toggle');
    $('#buscaTabelaOrdensBuscar').keyup(function () {

        tabelaLocalizarOrdem.search($(this).val()).draw();
    });
}

function AlterarTituloModalOrdens() {
    var filtroPor = parseInt($("#selectFiltrarPor option:selected").val());

    if (filtroPor === VALOR_OPCAO_BUSCAR_CLIENTE) {
        var opcaoSelecionada = $("#selectClientesFiltro option:selected");

        $('#tituloModalOrdensCliente').text(opcaoSelecionada[0].text);
    }
    else if (filtroPor === VALOR_OPCAO_BUSCAR_ORDENS_TIPO_EQUIPAMENTO) {
        var opcaoSelecionada = $("#selectTipoEquipamentoBuscar option:selected");

        $('#tituLoModalLocalizarOrdem').text('Tipo de Equipamento: ' + opcaoSelecionada[0].text);
    }
    else if (filtroPor === VALOR_OPCAO_BUSCAR_ORDENS_FABRICANTE) {
        var opcaoSelecionada = $("#selectBuscarPorFabricante option:selected");

        $('#tituLoModalLocalizarOrdem').text('Fabricante: ' + opcaoSelecionada[0].text);
    }
    else if (filtroPor === VALOR_OPCAO_BUSCAR_ORDENS_ROTACAO) {
        var opcaoSelecionada = $('#txtLocalizarOrdem').val();

        $('#tituLoModalLocalizarOrdem').text('RPM: ' + opcaoSelecionada);
    }
    else if (filtroPor === VALOR_OPCAO_BUSCAR_ORDENS_POTENCIA) {
        var opcaoSelecionada = ObterValorInput('txtLocalizarOrdem');

        $('#tituLoModalLocalizarOrdem').text('Potência: ' + opcaoSelecionada);
    }
    else if (filtroPor === VALOR_OPCAO_BUSCAR_NUMERO_SERIE_EQUIPAMENTO)
        $('#tituLoModalLocalizarOrdem').text('N° Série Equipamento: ' + txtLocalizarOrdem.value);
    else {
        $('#tituLoModalLocalizarOrdem').text('N° da Ordem: ' + txtLocalizarOrdem.value);
    }
}

function CriarEventoTabelaLocalizarOrdem() {

    $('#tabelaLocalizarOrdem tbody').on('dblclick', 'tr', function () {
        var id = this.id;
        RedirecionarVisualizarOrdemBuscar(id);
    });
}
