var txtLocalizarOrdem = document.getElementById("txtLocalizarOrdem");
var tabelaLocalizarOrdem = null;
var tabelaOrdensCliente = null;
var VALOR_OPCAO_BUSCAR_NUMERO_ORDEM = 1;
var VALOR_OPCAO_BUSCAR_CLIENTE = 2;
var VALOR_OPCAO_BUSCAR_NUMERO_SERIE_EQUIPAMENTO = 3;
var VALOR_OPCAO_BUSCAR_ORDENS_EMPRESTIMOS_EQUIPAMENTO = 4;
var VALOR_OPCAO_BUSCAR_ORDENS_VENDA = 5;
var VALOR_OPCAO_BUSCAR_ORDENS_TIPO_EQUIPAMENTO = 6;
var VALOR_OPCAO_BUSCAR_ORDENS_FABRICANTE = 7;
var VALOR_OPCAO_BUSCAR_ORDENS_ROTACAO = 8;
var VALOR_OPCAO_BUSCAR_ORDENS_POTENCIA = 9;
var VALOR_OPCAO_BUSCAR_ORDENS_NUMERO_NOTA = 10;

$("#selectFiltrarPor").change(function () {

    var valorSelecionado = parseInt($(this).val());

    if (valorSelecionado === VALOR_OPCAO_BUSCAR_NUMERO_ORDEM || valorSelecionado === VALOR_OPCAO_BUSCAR_NUMERO_SERIE_EQUIPAMENTO) {
        $('#divInputNumeroOrdemBuscar').show();
        $('#divSelectTipoEquipamentoBuscar').hide();
        $('#divSelectClienteBuscar').hide();
        $('#divSelectBuscarPorFabricante').hide();
    }
    else if (valorSelecionado === VALOR_OPCAO_BUSCAR_CLIENTE) {
        $('#divSelectClienteBuscar').show();
        $('#divSelectTipoEquipamentoBuscar').hide();
        $('#divInputNumeroOrdemBuscar').hide();
        $('#divSelectBuscarPorFabricante').hide();
        CarregarClientesSelectBuscar();
    }
    else if (valorSelecionado === VALOR_OPCAO_BUSCAR_ORDENS_TIPO_EQUIPAMENTO) {
        $('#divSelectTipoEquipamentoBuscar').show();
        $('#divSelectClienteBuscar').hide();
        $('#divInputNumeroOrdemBuscar').hide();
        $('#divSelectBuscarPorFabricante').hide();
        CarregarTiposEquipamentosSelectBuscar();
    }
    else if (valorSelecionado === VALOR_OPCAO_BUSCAR_ORDENS_FABRICANTE) {
        $('#divSelectBuscarPorFabricante').show();
        $('#divSelectClienteBuscar').hide();
        $('#divSelectTipoEquipamentoBuscar').hide();
        $('#divInputNumeroOrdemBuscar').hide();
        CarregarFabricantesSelectBuscar();
    }
    else if (valorSelecionado === VALOR_OPCAO_BUSCAR_ORDENS_ROTACAO) {
        $('#divInputNumeroOrdemBuscar').show();
        $('#divSelectBuscarPorFabricante').hide();
        $('#divSelectClienteBuscar').hide();
        $('#divSelectTipoEquipamentoBuscar').hide();
        
    }
    else if (valorSelecionado === VALOR_OPCAO_BUSCAR_ORDENS_POTENCIA) {
        $('#divInputNumeroOrdemBuscar').show();
        $('#divSelectBuscarPorFabricante').hide();
        $('#divSelectClienteBuscar').hide();
        $('#divSelectTipoEquipamentoBuscar').hide();
        
    }
    else if (valorSelecionado === VALOR_OPCAO_BUSCAR_ORDENS_EMPRESTIMOS_EQUIPAMENTO || valorSelecionado === VALOR_OPCAO_BUSCAR_ORDENS_VENDA) {
        $('#divInputNumeroOrdemBuscar').hide();
        $('#divSelectTipoEquipamentoBuscar').hide();
        $('#divSelectClienteBuscar').hide();
    }
    else if (valorSelecionado === VALOR_OPCAO_BUSCAR_ORDENS_NUMERO_NOTA) {
        $('#divInputNumeroOrdemBuscar').show();
        $('#divSelectTipoEquipamentoBuscar').hide();
        $('#divSelectClienteBuscar').hide();
    }
})

function CarregarClientesSelectBuscar() {

    var numeroDeOpcoes = $('#selectClientesFiltro option').length;

    if (numeroDeOpcoes > 1)
        return;

    $.ajax({
        dataType: "json",
        type: "GET",
        url: "/LizyClientes/ObterClientesLizy",
        success: function (response) {
            if (response.erro) return;
            AtualizarSelectPickerSelecionandoIdDescricaoDaLista(response.clientes, 'selectClientesFiltro', 'id', 'razao_social');
        }
    });
}


