function PreencherModalOrdensCliente(ordens, nomeCliente) {

    LimparTabela(tabelaOrdensCliente);

    AlterarTituloModalOrdens();

    for (var i = 0; i < ordens.length; i++) {

        tabelaOrdensCliente.row.add([
            ordens[i].numero_ordem,
            ordens[i].setor,
            ordens[i].status,
            ordens[i].potencia,
            ordens[i].nota_fiscal,
            ordens[i].rpm,
            ordens[i].tensao,
            ordens[i].corrente,
            ordens[i].tipo_equipamento,
            ordens[i].fabricante,
            ordens[i].modelo,
            ordens[i].numero_serie,
            CriarFuncaoOrdensCliente(ordens[i].id_ordem),
        ]).node().id = ordens[i].id_ordem;
    }

    tabelaOrdensCliente.draw();
    AbrirModal('modal-ordens-cliente');
    CriarEventoTabelaOrdensClientes();

    $('#buscaTabelaOrdensBuscarCliente').keyup(function () {
        tabelaOrdensCliente.search($(this).val()).draw();
    });
}

function CriarFuncaoOrdensCliente(idOrdem) {

    return '<a style="font-size:24px;" data-toggle="tooltip" title="Imprimir" onclick="ImprimirLaudoOrdemCliente(' + idOrdem + ')"' +
        'class="btn btn-link btn-info btn-just-icon like"><i class="material-icons">print</i></a>';
}

function ImprimirLaudoOrdemCliente(idOrdem) {

    $.ajax({
        dataType: "json",
        data: {
            idOrdem: idOrdem
        },
        type: "GET",
        url: "/Relatorio/GerarOrcamentoOrdem",
        success: function (dados) {
            PossuiRelatorioSendoGerado();
            $('#modal-ordens-cliente').modal('toggle');
        },
        error: function (dados) {
            PossuiRelatorioSendoGerado();
            $('#modal-ordens-cliente').modal('toggle');
        }
    });
}

function CriarEventoTabelaOrdensClientes() {

    $('#tabelaOrdensCliente tbody').on('dblclick', 'tr', function () {
        var id = this.id;
        RedirecionarVisualizarOrdemBuscar(id);
    });
}

function LocalizarOrdem() {
    $.ajax({
        dataType: "json",
        data: {
            numeroOrdem: txtLocalizarOrdem.value,
        },
        type: "GET",
        url: "/Ordem/LocalizarOrdem",
        success: function (response) {
            if (response.erro) swal('Atenção', 'Ordem não encontrada', 'warning');
            else if (response.idOrdem != null) RedirecionarVisualizarOrdemBuscar(response.idOrdem);
            else MostrarModalComOrdens(response.ordens);
        }
    });
}

