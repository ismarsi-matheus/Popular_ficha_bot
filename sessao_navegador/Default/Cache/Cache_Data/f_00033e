$("#botaoBuscar").click(function () {

    var filtroPor = parseInt($("#selectFiltrarPor option:selected").val());

    if (filtroPor === VALOR_OPCAO_BUSCAR_CLIENTE)
        BuscarCliente();
    else if (filtroPor === VALOR_OPCAO_BUSCAR_ORDENS_TIPO_EQUIPAMENTO)
        BuscarOrdensPeloTipoEquipamento();
    else if (filtroPor === VALOR_OPCAO_BUSCAR_ORDENS_FABRICANTE)
        BuscarOrdensPeloFabricante();
    else if (filtroPor === VALOR_OPCAO_BUSCAR_ORDENS_ROTACAO)
        BuscarOrdensPeloRPM();
    else if (filtroPor === VALOR_OPCAO_BUSCAR_ORDENS_POTENCIA)
        BuscarOrdensPelaPotencia();
    else if (filtroPor === VALOR_OPCAO_BUSCAR_NUMERO_SERIE_EQUIPAMENTO)
        BuscarOrdensPeloNumeroSerieEquipamento();
    else if (filtroPor === VALOR_OPCAO_BUSCAR_ORDENS_EMPRESTIMOS_EQUIPAMENTO)
        BuscarOrdensDeEmprestimo();
    else if (filtroPor === VALOR_OPCAO_BUSCAR_ORDENS_VENDA)
        BuscarOrdensDeVenda();
    else if (filtroPor === VALOR_OPCAO_BUSCAR_ORDENS_NUMERO_NOTA)
        BuscarOrdensNumeroNota();
    else
        LocalizarOrdem();
});

function BuscarCliente() {

    var opcaoSelecionada = $("#selectClientesFiltro option:selected");

    if (IsNullOrEmpty(opcaoSelecionada[0].value))
        return;

    $.ajax({
        dataType: "json",
        data: {
            idCliente: opcaoSelecionada[0].value,
        },
        type: "GET",
        url: "/Ordem/ObterOrdensCliente",
        success: function (response) {
            if (response === null)
                return;
            PreencherModalOrdensCliente(response.ordens, opcaoSelecionada[0].text);
        }
    });
}


function BuscarOrdensPeloTipoEquipamento() {

    var opcaoSelecionada = $("#selectTipoEquipamentoBuscar option:selected");

    if (IsNullOrEmpty(opcaoSelecionada[0].value))
        return;

    $.ajax({
        dataType: "json",
        data: {
            idTipoEquipamento: opcaoSelecionada[0].value,
        },
        type: "GET",
        url: "/Ordem/ObterOrdensPeloTipoEquipamento",
        success: function (response) {
            if (response === null) return;
            if (response.erro) swal('Atenção', 'Nenhuma ordem encontrada para esse tipo de Equipamento!', 'warning');
            else if (response.ordens.length == 1) RedirecionarVisualizarOrdemBuscar(response.ordens[0].id_ordem);
            MostrarModalComOrdens(response.ordens, opcaoSelecionada[0].text);
        }
    });
}

