    $(document).on('input', '#' + ID_ELEMENTO_INPUT_VALOR_UNITARIO_PECA_DA_ORDEM, AtualizarValoresPecaOrdemDinamicamente);
    $(document).on('input', '#' + ID_ELEMENTO_INPUT_VALOR_TOTAL_PECA_DA_ORDEM, AtualizarValoresPecaOrdemDinamicamente);

    $('#' + ID_ELEMENTO_PORCENTAGEM_IPI_PECA_DA_ORDEM).mask('##0,00%', { reverse: true });
    $('#' + ID_ELEMENTO_PORCENTAGEM_ICMS_PECA_DA_ORDEM).mask('##0,00%', { reverse: true });

    ValidarPermissaoOrcamentosLizy(() => {
        _displayValor = false;
        $('#divValorUnitarioPecaDaOrdem').addClass('d-none');
        $('#divValorTotalPecaDaOrdem').addClass('d-none');
        $('#divPorcentagemIpiPecaDaOrdem').addClass('d-none');
        $('#divPorcentagemIcmsPecaDaOrdem').addClass('d-none');
        $('#divSelectDiscriminarItensPecaDaOrdem').addClass('d-none');

        tabelaPecas.column(ID_ELEMENTO_INPUT_VALOR_UNITARIO_PECA_DA_ORDEM).visible(false);
        tabelaPecas.column(ID_ELEMENTO_INPUT_VALOR_TOTAL_PECA_DA_ORDEM).visible(false);
        tabelaPecas.column(ID_ELEMENTO_PORCENTAGEM_IPI_PECA_DA_ORDEM).visible(false);
        tabelaPecas.column(ID_ELEMENTO_PORCENTAGEM_ICMS_PECA_DA_ORDEM).visible(false);
    }, () => {
        _displayValor = true;
        tabelaPecas.column(ID_ELEMENTO_INPUT_VALOR_UNITARIO_PECA_DA_ORDEM).visible(true);
        tabelaPecas.column(ID_ELEMENTO_INPUT_VALOR_TOTAL_PECA_DA_ORDEM).visible(true);
        tabelaPecas.column(ID_ELEMENTO_PORCENTAGEM_IPI_PECA_DA_ORDEM).visible(true);
        tabelaPecas.column(ID_ELEMENTO_PORCENTAGEM_ICMS_PECA_DA_ORDEM).visible(true);
    });
});

const ID_MODAL_ALTERAR_PECA_DA_ORDEM = 'modal-alterar-peca-da-ordem';
const ID_ELEMENTO_BOTAO_ALTERAR_PECA_DA_ORDEM = 'btnSalvarAlteracaoPecaDaOrdem';

const ID_ELEMENTO_INPUT_DESCRICAO_PECA_DA_ORDEM = 'txtDescricaoPecaDaOrdem';
const ID_ELEMENTO_INPUT_QUANTIDADE_PECA_DA_ORDEM = 'txtQuantidadePecaDaOrdem';
const ID_ELEMENTO_INPUT_VALOR_UNITARIO_PECA_DA_ORDEM = 'txtValorUnitarioPecaDaOrdem';
const ID_ELEMENTO_INPUT_VALOR_TOTAL_PECA_DA_ORDEM = 'txtValorTotalPecaDaOrdem';
const ID_ELEMENTO_INPUT_DESCRICAO_ORCAMENTO_PECA_DA_ORDEM = 'txtDescricaoOrcamentoPecaDaOrdem';
const ID_ELEMENTO_INPUT_UNIDADE_MEDIDA_PECA_DA_ORDEM = 'txtUnidadeMedidaPecaDaOrdem';
const ID_ELEMENTO_INPUT_ID_PECA_DA_ORDEM = 'txtIdPecaOrdemASerAlterada';

const ID_ELEMENTO_PORCENTAGEM_IPI_PECA_DA_ORDEM = 'txtPorcentagemIpiPecaDaOrdem';
const ID_ELEMENTO_PORCENTAGEM_ICMS_PECA_DA_ORDEM = 'txtPorcentagemIcmsPecaDaOrdem';
const ID_ELEMENTO_OBSERVACAO_PECA_DA_ORDEM = 'txtObservacaoPecaDaOrdem';

const ID_CHECKBOX_REUTILIZAR_PECA_MODAL = 'checkReutilizarPecaModal';
const ID_CHECKBOX_CLIENTE_FORNECE_MODAL = 'checkClienteForneceModal';

const ID_SELECTPICKER_DISCRIMINAR_ITENS_PECA_DA_ORDEM = 'selectDiscriminarItensPecaDaOrdem';
const DIV_SELECTPICKER_DISCRIMINAR_ITENS_PECA_DA_ORDEM = 'divSelectDiscriminarItensPecaDaOrdem';

let ehKit = false;
let idKitVinculado = null;

var valorUnitarioOriginal = null;
var valorTotalOriginal = null;


$(document).on('input', '.dinheiro', function () {
    this.value = this.value.replace(/[^\d.,]/g, '');
});


$(document).on('hide.bs.modal', '#' + ID_MODAL_ALTERAR_PECA_DA_ORDEM, function () {
    LimparInput(ID_ELEMENTO_INPUT_DESCRICAO_PECA_DA_ORDEM);
    LimparInput(ID_ELEMENTO_INPUT_QUANTIDADE_PECA_DA_ORDEM);
    LimparInput(ID_ELEMENTO_INPUT_VALOR_UNITARIO_PECA_DA_ORDEM);
    LimparInput(ID_ELEMENTO_INPUT_VALOR_TOTAL_PECA_DA_ORDEM);
    LimparInput(ID_ELEMENTO_INPUT_DESCRICAO_ORCAMENTO_PECA_DA_ORDEM);
    LimparInput(ID_ELEMENTO_INPUT_UNIDADE_MEDIDA_PECA_DA_ORDEM);
    LimparInput(ID_ELEMENTO_PORCENTAGEM_IPI_PECA_DA_ORDEM);
    LimparInput(ID_ELEMENTO_PORCENTAGEM_ICMS_PECA_DA_ORDEM);
    LimparInput(ID_ELEMENTO_OBSERVACAO_PECA_DA_ORDEM);
    LimparCheckBox(ID_CHECKBOX_REUTILIZAR_PECA_MODAL);
    LimparCheckBox(ID_CHECKBOX_CLIENTE_FORNECE_MODAL);
    ResetSelectPicker(ID_SELECTPICKER_DISCRIMINAR_ITENS_PECA_DA_ORDEM);
