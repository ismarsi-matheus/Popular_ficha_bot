    HabilitarBotao('btnAdicionarServicosExternosDaOrdem', 'Adicionar');
}

var _quantidadeHorasTodosOsServicosinternosOrdem = "";

function ObterServicosDaOrdem() {
    let idOrdem = $('#txtIdOrdem').val();
    $.ajax({
        dataType: "json",
        type: "GET",
        url: "/ServicosDaOrdem/ObterServicosDaOrdem/" + idOrdem,
        success: function (response) {

            LimparTabela(tabelaServicosDaOrdem);

            for (let i = 0; i < response.servico_ordem.length; i++) {

                tabelaServicosDaOrdem.row.add([
                    response.servico_ordem[i].descricao,
                    response.servico_ordem[i].setor_descricao,
                    "R$ " + FormatDinheiro(response.servico_ordem[i].valor_venda),
                    response.servico_ordem[i].componente_equipamento_descricao,
                    response.servico_ordem[i].quantidade_horas_previstas,
                    response.servico_ordem[i].observacao,
                    FormataJsonDataHora(response.servico_ordem[i].data_inicio_trabalho),
                    FormataJsonDataHora(response.servico_ordem[i].data_fim_trabalho),
                    CriarFuncoesTabelaServicosDaOrdem(response.servico_ordem[i].id_servico_da_ordem),
                    response.servico_ordem[i].id_setor_realiza_servico,
                    response.servico_ordem[i].id_componente_equipamento_vai_ser_realizado_servico,
                ]).node().id = response.servico_ordem[i].id_servico_da_ordem;
            }

            let horasPrevistas = response.servico_ordem.map(a => a.quantidade_horas_previstas);

            let totalHoras = horasPrevistas.reduce((acc, time) => acc.add(moment.duration(time)), moment.duration());
            let quantidadeHoras = Math.floor(totalHoras.asHours());

            _quantidadeHorasTodosOsServicosinternosOrdem = [quantidadeHoras, AddZero(totalHoras.minutes())].join(':');

            $('#' + ID_ELEMENTO_LABEL_QUANTIDADE_TOTAL_HORAS_SERVICOS_ORDEM).text(_quantidadeHorasTodosOsServicosinternosOrdem);

            $('#' + ID_ELEMENTO_LABEL_QUANTIDADE_TOTAL_DIAS_SERVICOS_ORDEM).text(CalcularQuantidadeDiasDeTrabalho(quantidadeHoras));

            CalcularValorTotalHorasCustoEVenda();

            RenderizarDatatable(tabelaServicosDaOrdem);
        }
    });
}


function CalcularValorTotalHorasCustoEVenda() {

    if (IsNullOrEmpty(_quantidadeHorasTodosOsServicosinternosOrdem)) return;

    let valorTotalCustoHoras = ObterValorTotalCustoHorasServico();
    let valorTotalVendaHoras = ObterValorTotalVendaHorasServico();

    $('#' + ID_ELEMENTO_LABEL_VALOR_TOTAL_CUSTO_HORA_SERVICOS_ORDEM).text('R$ ' + FormatDinheiro(valorTotalCustoHoras));
    $('#' + ID_ELEMENTO_LABEL_VALOR_TOTAL_VENDA_HORA_SERVICOS_ORDEM).text('R$ ' + FormatDinheiro(valorTotalVendaHoras));

    CalcularValorTotalCusto();


    if (PaginaAtivaEh('FilaOrcamento')) {
        CalcularValorTotalVenda();
    }
}

function ObterValorTotalCustoHorasServico() {

    if (IsNullOrEmpty(_quantidadeHorasTodosOsServicosinternosOrdem)) return;

    let valorCustoHora = FormatarDinheiroParaDecimal(ObterValorInput(ID_ELEMENTO_INPUT_VALOR_CUSTO_HORA_SERVICOS_ORDEM));

    let quantidadeHoras = FormatarDinheiroParaDecimal(_quantidadeHorasTodosOsServicosinternosOrdem.split(':')[0]);
    let quantidadeMinutos = FormatarDinheiroParaDecimal(_quantidadeHorasTodosOsServicosinternosOrdem.split(':')[1]);

    let valorTotalCustoHoras = quantidadeHoras * valorCustoHora;

    valorTotalCustoHoras += (((quantidadeMinutos * 100) / 60) / 100) * valorCustoHora;

    return valorTotalCustoHoras;
}

function ObterValorTotalVendaHorasServico() {

    if (!$.fn.DataTable.isDataTable('#tabelaServicosDaOrdem')) return;

    let rowsData = tabelaServicosDaOrdem.rows().data();

    let valorTotalVenda = 0;

    for (let i = 0; i < rowsData.length; i++) {

        valorTotalVenda += FormatarDinheiroParaDecimal(rowsData[i][INDEX_VALOR_VENDA_TABELA_SERVICO_ORDEM]);
    }

    return valorTotalVenda;
}

function CalcularQuantidadeDiasDeTrabalho(totalHoras) {
    const QUANTIDADE_HORAS_CCONSIDERADAS = 8;

    return Math.ceil(totalHoras / QUANTIDADE_HORAS_CCONSIDERADAS);
}

function AdicionarServicoASerRealizadoSetor() {

    let objeto = GerarObjetoServicoOrdemASerRealizadoNoSetor(ObterValorInput(ID_ELEMENTO_DESCRICAO_SERVICO_DA_ORDEM_ORDEM_EDITAR), ObterValorSelectPicker(ID_ELEMENTO_SETOR_REALIZA_SERVICO_ORDEM_EDITAR),
        ObterValorInput(ID_ELEMENTO_QUANTIDADE_HORAS_SERVICO_ORDEM_EDITAR), ObterValorInput(ID_ELEMENTO_OBSERVACAO_SERVICO_DA_ORDEM_ORDEM_EDITAR), ObterValorInput('txtIdOrdem'),
        ObterValorSelectPicker(ID_ELEMENTO_SELECTPICKER_COMPONENTE_EQUIPAMENTO_QUE_SERA_REALIZADO_SERVICO_ORDEM_ADICIONAR_TABELA), ObterValorInput(ID_ELEMENTO_VALOR_SERVICO_DA_ORDEM_EDITAR));

    RequestAdicionarServicoASerRealizadoSetor(objeto);
}


function RequestAdicionarServicoASerRealizadoSetor(objeto, buscarServicosDaOrdem = true) {

    $.ajax({
        data: JSON.stringify(objeto),
        type: "POST",
        url: "/ServicosDaOrdem/AdicionarServicoDaOrdem",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (response.erro)
                swal("Ops!", response.mensagem, "warning");
            else {
                if (buscarServicosDaOrdem) {
                    swal("Sucesso", "Adicionado com sucesso", "success");

                    LimparCamposAdicionarServicosDaOrdem();
                    ObterServicosDaOrdem();
                }
            }
        }
    });
}

function GerarObjetoServicoOrdemASerRealizadoNoSetor(descricao, idSetorRealizaServico, quantidadeHorasPrevistas, observacao, idOrdem, idComponenteEquipamentoVaiSerRealizadoServico, valorServico) {

    return {
        "descricao": descricao,
        "id_setor_realiza_servico": idSetorRealizaServico,
        "quantidade_horas_previstas": quantidadeHorasPrevistas,
        "observacao": observacao,
        "id_servico_da_ordem": 0,
        "id_ordem": idOrdem,
        "data_inicio_trabalho": null,
        "data_fim_trabalho": null,
        "criado_pelo_sistema": 0,
        "prioridade": null,
        "excluido": 0,
        "id_componente_equipamento_vai_ser_realizado_servico": idComponenteEquipamentoVaiSerRealizadoServico,
        "valor_venda": FormatarDinheiroParaDecimal(valorServico)
    };
}


function ExcluirServicoDaOrdem(idServico) {
    swal({
        title: "Você tem certeza que deseja excluir esse Serviço da Ordem?",
        text: "O mesmo possui informações vinculadas e você poderá perdê-las!",
        icon: "warning",
        buttons: true
    })
        .then((willDelete) => {
            if (willDelete) {
                $.ajax({
                    url: "/ServicosDaOrdem/ExcluirServicoDaOrdem/" + idServico,
                    type: "PUT",
                    success: function (response) {

                        if (response.erro) {
                            swal("Ops!", "Houve um erro ao alterar o cliente. Detalhes: " + response.mensagem, "error");
                            HabilitarBotao('btnAlterarCliente', 'Alterar');
                        }
                        else {
                            swal("Sucesso!", "O Serviço da Ordem foi excluído com sucesso!", "success");
                            ObterServicosDaOrdem();
                        }
                    }
                })
            }
            else swal("Cancelado!", "Exclusão cancelada!", "error");
        });

}

function CriarFuncoesTabelaServicosDaOrdem(idServico) {
    var htmlFuncoes = "";

    htmlFuncoes += '<a href="javascript:void(0);" onclick="AbrirModalAlterarServicoOrdem(' + idServico + ')" class="btn btn-link btn-primary btn-just-icon edit">' +
        '<i class="fas fa-clipboard-list"></i>' +
        '</a>';

    htmlFuncoes += '<a href="javascript:void(0);" onclick="ExcluirServicoDaOrdem(' + idServico + ')" class="btn btn-link btn-warning btn-just-icon edit">' +
        '<i class="material-icons">clear</i>' +
        '</a>';

    return htmlFuncoes;
}

function GerarServicosDaOrdemBaseadoNosTrabalhosSelecionados() {

    let idOrdem = $('#txtIdOrdem').val();

    let body = CarregarOrdemEdicaoBody();

    $('#labelServicosSendoGerados').show();
    $('#labelGerarServicos').hide();

    $.ajax({
        url: "/ServicosDaOrdem/AlterarServicoDaOrdem/" + idOrdem,
        type: "PUT",
        data: JSON.stringify(body),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (response.erro) {
                swal("Ops!", "Houve um erro ao alterar a ordem. Detalhes: " + response.mensagem, "error");
            }
            else {
                ObterServicosDaOrdem();
                swal("Sucesso!", "Serviços gerados com sucesso!", "success");
            }

            $('#labelServicosSendoGerados').hide();
            $('#labelGerarServicos').show();
        }
    });
}

function ObterListaServicosPadroes() {
    $.ajax({
        url: "/EscopoDoServico/ObterServicosPadroes",
        type: "GET",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {

            if (!response.erro) {
                $.each(response.servicos_padroes, function (i, item) {
                    $("#datalistServicosPadroes").append($("<option>").attr('value', item).text(item));
                });
            }
        }
    });
}

function ObterServicosPadroesComBaseDescricao() {
    $.ajax({
        url: "/EscopoDoServico/ObterServicosPadroesComBaseDescricao",
        type: "GET",
        data: {
            descricao: $('#txtDescricaoServicoDaOrdemAdicionarTabela').val()
        },
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (!response.erro) {

                if (IsNullOrEmpty(response.servico)) return;

                if (!IsNullOrEmpty(response.servico.id_setor_responsavel_servico_da_ordem_ao_aprovar))
                    UpdateSelectPicker(ID_ELEMENTO_SETOR_REALIZA_SERVICO_ORDEM_EDITAR, response.servico.id_setor_responsavel_servico_da_ordem_ao_aprovar);

                if (!IsNullOrEmpty(response.servico.id_componente_vai_realizar_servico))
                    UpdateSelectPicker(ID_ELEMENTO_SELECTPICKER_COMPONENTE_EQUIPAMENTO_QUE_SERA_REALIZADO_SERVICO_ORDEM_ADICIONAR_TABELA, response.servico.id_componente_vai_realizar_servico);
            }
        }
    });
}


function AddInputServicoOrdem(elmemento, campoEhHoras, campoEhValor) {
    if (elmemento.getElementsByTagName('input').length > 0) return;

    _valorAntesEdicao = elmemento.innerHTML;
    elmemento.innerHTML = '';

    var input = document.createElement('input');
    input.setAttribute('type', 'text');
    input.setAttribute('id', 'inputEditando');
    input.setAttribute('class', 'editando');
    input.setAttribute('style', 'width:100%');
    input.setAttribute('onBlur', 'CloseInputServicoOrdem(this,' + campoEhHoras + ', ' + campoEhValor + ')');
    input.setAttribute('onkeyup', 'enterVerify(event)');
    elmemento.appendChild(input);
    input.focus();
    if (campoEhHoras) $('#inputEditando').mask('000:00', { reverse: true });
    if (campoEhValor) $('#inputEditando').mask("###0,00", { reverse: true });

    $('#inputEditando').val('');
}

function CloseInputServicoOrdem(elmemento, campoEhHoras, campoEhValor) {
    var td = elmemento.parentNode;
    var value = elmemento.value;
    td.removeChild(elmemento);
    if (_valorAntesEdicao !== value && value !== "") {

        td.innerHTML = 'Alterando...';

        if (campoEhHoras)
            value = ValidarValorHora(value)

        AlterarServicoDaOrdemPelaTabela(value, td, _valorAntesEdicao);

    }
    else td.innerHTML = _valorAntesEdicao;

    _valorAntesEdicao = '';
}

function ValidarValorHora(valorHora) {
    if (valorHora === '' || valorHora === '' || valorHora === null || valorHora === 'NaN') {
        return '';
    }
    else {
        if (!/:/.test(valorHora)) {
            valorHora += ':00';
        }
        //Caso esteja como 14:
        else if (valorHora.length === 3) {
            valorHora += '00';
        }

        return valorHora = valorHora.replace(/^\d{1}:/, '0$&').replace(/:\d{1}$/, '$&0');
    }
}

function AlterarServicoDaOrdemPelaTabela(novoValor, tdTabela, valorSeDerErro) {

    let requestURL = '/ServicosDaOrdem/AlterarObservacaoServicoOrdem';

    if (IndexColunaEditandoServicoOrdem == INDEX_QUANTIDADE_HORAS_TABELA_SERVICO_ORDEM)
        requestURL = '/ServicosDaOrdem/AlterarHoraServicoOrdem';
    else if (IndexColunaEditandoServicoOrdem == INDEX_DESCRICAO_SERVICO_TABELA_SERVICO_ORDEM)
        requestURL = '/ServicosDaOrdem/AlterarDescricaoServicoDaOrdem';
    else if (IndexColunaEditandoServicoOrdem == INDEX_VALOR_VENDA_TABELA_SERVICO_ORDEM) {
        requestURL = '/ServicosDaOrdem/AlterarValorVendaServico';
        novoValor = FormatarDinheiroParaDecimal(novoValor);
    }

    $.ajax({
        data: JSON.stringify(novoValor),
        type: "PUT",
        url: requestURL + '/' + IDServicoOrdemEditandoNaTabela,
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (response.erro) {
                swal("Ops!", response.mensagem, "warning");

                tdTabela.innerHTML = valorSeDerErro;
            }
            else {
                ObterServicosDaOrdem();
            }
        }
    });
}