const INDEX_DESCRICAO_SETOR_REALIZA_SERVICO_TABELA_SERVICO_ORDEM = 1;
const INDEX_VALOR_VENDA_TABELA_SERVICO_ORDEM = 2;
const INDEX_DESCRICAO_COMPONENTE_EQUIPAMENTO_SERA_REALIZADO_SERVICO_TABELA_SERVICO_ORDEM = 3;
