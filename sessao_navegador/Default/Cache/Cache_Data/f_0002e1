const INDEX_OBSERVACAO_TABELA_SERVICO_ORDEM = 5;
const INDEX_DATA_INICIO_TABELA_SERVICO_ORDEM = 6;
const INDEX_DATA_FIM_TABELA_SERVICO_ORDEM = 7;
const INDEX_FUNCOES_TABELA_SERVICO_ORDEM = 8;
const INDEX_ID_SETOR_REALIZA_SERVICO_TABELA_SERVICO_ORDEM = 9;
const INDEX_ID_COMPONENTE_EQUIPAMENTO_SERA_REALIZADO_SERVICO_TABELA_SERVICO_ORDEM = 10;

const ID_ELEMENTO_DESCRICAO_SERVICO_DA_ORDEM_ORDEM_EDITAR = 'txtDescricaoServicoDaOrdemAdicionarTabela';
const ID_ELEMENTO_VALOR_SERVICO_DA_ORDEM_EDITAR = 'txtValorServicoDaOrdemAdicionarTabela';
const ID_ELEMENTO_QUANTIDADE_HORAS_SERVICO_ORDEM_EDITAR = 'txtQuantidadeHorasServicoDaOrdemAdicionarTabela';
