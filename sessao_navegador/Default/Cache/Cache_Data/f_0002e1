}

function LimparCamposAdicionarServicosDaOrdem() {

    LimparInput(ID_ELEMENTO_DESCRICAO_SERVICO_DA_ORDEM_ORDEM_EDITAR, 'divDescricaoServicoDaOrdemAdicionarTabela');
    LimparInput(ID_ELEMENTO_VALOR_SERVICO_DA_ORDEM_EDITAR, 'divValorServicoDaOrdemAdicionarTabela');
    LimparInput(ID_ELEMENTO_QUANTIDADE_HORAS_SERVICO_ORDEM_EDITAR, 'divQuantidadeHorasServicoDaOrdemAdicionarTabela');
    LimparInput(ID_ELEMENTO_OBSERVACAO_SERVICO_DA_ORDEM_ORDEM_EDITAR, 'divObservacoesServicoDaOrdemAdicionarTabela');
