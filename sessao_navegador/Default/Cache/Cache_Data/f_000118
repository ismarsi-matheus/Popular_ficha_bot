const ID_ELEMENTO_INPUT_CLASSE_QUALIDADE_BALANCEAMENTO = 'txt2476';
const ID_ELEMENTO_INPUT_MASSA_ROTOR = 'txt2473';
const ID_ELEMENTO_INPUT_DESBALANCEAMENTO_RESIDUAL_ADMISSIVEL = 'txt2477';
const ID_ELEMENTO_INPUT_DESBALANCEAMENTO_RESIDUAL_ADMISSIVEL_2 = 'txt2518';
const ID_ELEMENTO_INPUT_DESBALANCEAMENTO_RESIDUAL_ADMISSIVEL_POR_PLANO = 'txt2478';
const ID_ELEMENTO_INPUT_R1 = 'txt2481';
const ID_ELEMENTO_INPUT_R2 = 'txt2482';
const ID_ELEMENTO_INPUT_TOLERANCIA_PLANO_R1 = 'txt2520';
const ID_ELEMENTO_INPUT_TOLERANCIA_PLANO_R2 = 'txt2521';
