const HTML_ICONE_TESTE_NAO_CONFORME = '<i class="fas fa-times"></i>';

function CalcularITResistenciaOhmica(idCampoValor1, idCampoValor2, idCampoValor3, idLabel) {
    let valorCampo1 = ObterValorInput(idCampoValor1);
    let valorCampo2 = ObterValorInput(idCampoValor2);
    let valorCampo3 = ObterValorInput(idCampoValor3);

    if (IsNullOrEmpty(valorCampo1) || IsNullOrEmpty(valorCampo2) || IsNullOrEmpty(valorCampo3)) return;

    let maiorNumero = Math.max.apply(null, [FormatarDinheiroParaDecimal(valorCampo1), FormatarDinheiroParaDecimal(valorCampo2), FormatarDinheiroParaDecimal(valorCampo3)]);
    let menorNumero = Math.min.apply(null, [FormatarDinheiroParaDecimal(valorCampo1), FormatarDinheiroParaDecimal(valorCampo2), FormatarDinheiroParaDecimal(valorCampo3)]);

    menorNumero += (menorNumero * 5) / 100;

    if (maiorNumero > menorNumero) {
        AdicionarIconeTesteNaoConforme(idLabel);
        $('#' + idLabel).addClass('text-danger');
    }
    else {
        RemoverIconeTesteNaoConforme(idLabel);
        $('#' + idLabel).removeClass('text-danger');
    }
}

function CalcularITResistenciaIsolacao(idCampoValor1, idCampoValor2, idCampoValor3, idCampoAbsorcao, idCampoPolarizacao, idLabel) {
    let valorCampo1 = ObterValorInput(idCampoValor1);
    let valorCampo2 = ObterValorInput(idCampoValor2);
    let valorCampo3 = ObterValorInput(idCampoValor3);
    let valorAbsorcacao = ObterValorInput(idCampoAbsorcao);
    let valorPolarizacao = ObterValorInput(idCampoPolarizacao);

    // if (IsNullOrEmpty(valorCampo1) || IsNullOrEmpty(valorCampo2) || IsNullOrEmpty(valorCampo3) || IsNullOrEmpty(valorAbsorcacao) || IsNullOrEmpty(valorPolarizacao)) return;

    let valorCampo1Formatado = FormatarDinheiroParaDecimal(valorCampo1);
    let valorCampo2Formatado = FormatarDinheiroParaDecimal(valorCampo2);
    let valorCampo3Formatado = FormatarDinheiroParaDecimal(valorCampo3);
    let valorCampoAbsorcacao = FormatarDinheiroParaDecimal(valorAbsorcacao);
    let valorCampoPolarizacao = FormatarDinheiroParaDecimal(valorPolarizacao);

    if ((valorCampo1Formatado < 100 && valorCampo1Formatado > 0) || (valorCampo2Formatado < 100 && valorCampo2Formatado > 0) || (valorCampo3Formatado < 100 && valorCampo3Formatado > 0)) {
        AdicionarIconeTesteNaoConforme(idLabel);
        $('#' + idLabel).addClass('text-danger');
        return;
    }

    if (valorCampoAbsorcacao < 1.4 && valorCampoAbsorcacao > 0) {
        AdicionarIconeTesteNaoConforme(idLabel);
        $('#' + idLabel).addClass('text-danger');
        return;
    }

    if (valorCampoPolarizacao < 2 && valorCampoPolarizacao > 0) {
        AdicionarIconeTesteNaoConforme(idLabel);
        $('#' + idLabel).addClass('text-danger');
        return;
    }

    RemoverIconeTesteNaoConforme(idLabel);
    $('#' + idLabel).removeClass('text-danger');
}

