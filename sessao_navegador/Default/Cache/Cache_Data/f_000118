function AtualizarSelectPickerPreGrupo(registros, preGrupo, idValorSelecionado) {

    var nomeSelectPicker = 'select' + preGrupo.id_pre_grupo_tabela_referenciada;
    AtualizarSelectPicker(registros, nomeSelectPicker, 'id');

    if (idValorSelecionado) UpdateSelectPicker(nomeSelectPicker, idValorSelecionado);
}

const PREFIXO_DATA_ATTRIBUTE_CODIGO_SUBGRUPO_DESCRICAO = "data-codigo-subgrupo";
const PREFIXO_DATA_ATTRIBUTE_CODIGO_SUBGRUPO = PREFIXO_DATA_ATTRIBUTE_CODIGO_SUBGRUPO_DESCRICAO + "='";

function GerarHtmlCampo(campo, editavel) {

    var html = "";

    if (campo.id_tipo_campo === ID_TIPO_CAMPO_INPUT) html += CriaCampoInput(campo, editavel);
    else if (campo.id_tipo_campo === ID_TIPO_CAMPO_TEXTAREA) html += CriaCampoTextArea(campo, editavel);
    else if (campo.id_tipo_campo === ID_TIPO_CAMPO_CHECKBOX) html += CriaCampoCheckBox(campo, editavel);
    else if (campo.id_tipo_campo === ID_TIPO_CAMPO_RADIOBUTTON) html += CriaCampoRadioButton(campo, editavel);
    else if (campo.id_tipo_campo === ID_TIPO_CAMPO_SELECTPICKER) {
        html += CriaCampoSelectPicker(campo, editavel);
        _listaIDSelectPickers.push(campo.id_campo_ficha);

    }
    else if (campo.id_tipo_campo === ID_TIPO_CAMPO_DATETIMEPICKER) html += CriaCampoDateTimePicker(campo, editavel);
    else if (campo.id_tipo_campo === ID_TIPO_CAMPO_DATEPICKER) html += CriaCampoDatePicker(campo, editavel);
    else if (campo.id_tipo_campo === ID_TIPO_CAMPO_TIMEPICKER) html += CriaCampoTimePicker(campo, editavel);
    else if (campo.id_tipo_campo === ID_TIPO_CAMPO_FOTOS) {
        html += CriaCampoFotos(campo);
        html += CriaCampoFotosIlimitados(campo);
    }
    else if (campo.id_tipo_campo === ID_TIPO_CAMPO_TITULO) {
        html += CriaCampoTitulo(campo);
        _listaIDTitulos.push(idCampoFicha);
    }
    else if (campo.id_tipo_campo === ID_TIPO_CAMPO_LABEL) html += CriaCampoLabel(campo, editavel);

    return html;
}

function CriaCampoInput(campoInput, editavel) {

    var html = "";

    let onBlurEvent = "";
    let styleDivDefault = '';

    if (!IsNullOrEmpty(campoInput.on_blur_event)) {
        onBlurEvent = 'onblur="' + campoInput.on_blur_event + '"';
    }

    let dataAttributeCodigoSubGrupo = "";

    if (!IsNullOrEmpty(campoInput.codigo_subgrupo)) {
        dataAttributeCodigoSubGrupo = PREFIXO_DATA_ATTRIBUTE_CODIGO_SUBGRUPO + campoInput.codigo_subgrupo + "'";;
        styleDivDefault = 'display:none';
    }

    let valorPadraoCampo = "";

    if (!IsNullOrEmpty(campoInput.valor_padrao))
        valorPadraoCampo = campoInput.valor_padrao;

    let quantidadeColunasMobile = '';

    if (!IsNullOrEmpty(campoInput.quantidade_colunas_mobile))
        quantidadeColunasMobile = ' col-' + campoInput.quantidade_colunas_mobile

    let classeDiv = '';

    if (!IsNullOrEmpty(campoInput.classes_div))
        classeDiv = campoInput.classes_div;

    html += "<div class=' " + quantidadeColunasMobile + " col-md-" + campoInput.quantidade_colunas + "   " + classeDiv + "' >" +
        "      <div class='form-group' id='div" + campoInput.id_campo_ficha + "' style='" + styleDivDefault + "'> " +
        "           <label for='txt" + campoInput.id_campo_ficha + "' class='bmd-label-floating'>" + campoInput.nome_campo + "</label>" +
        "           <input type='text' data-='" + campoInput.descricao_subgrupo_campo_pertence + "' " + dataAttributeCodigoSubGrupo + " value='" + valorPadraoCampo + "' name='txt" + campoInput.id_campo_ficha + "' id='txt" + campoInput.id_campo_ficha + "' " + onBlurEvent + " class='form-control input-xl input-valor-campo conversao-maiusculo " + campoInput.classes_campo + "'" +
