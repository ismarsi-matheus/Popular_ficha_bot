function DesmarcarCheckBoxExecutandoChange(checkboxId) {
    isProgrammaticChange = true;
    $('#' + checkboxId).prop('checked', false).trigger("change");
    isProgrammaticChange = false;
}

function PermitirApenasUmCheckboxTresParametros(id1, id2, id3) {

    if (isProgrammaticChange) return;

    var elementoClicado = (typeof event !== 'undefined' && event) ? event.target : null;
    if (!elementoClicado) return;
    var idClicado = elementoClicado.id;

    var idCheck1 = 'check' + id1;
    var idCheck2 = 'check' + id2;
    var idCheck3 = 'check' + id3;

    if (!elementoClicado.checked) return;

    if (idClicado === idCheck1) {
        DesmarcarCheckBoxExecutandoChange(idCheck2);
        DesmarcarCheckBoxExecutandoChange(idCheck3);
    }
    else if (idClicado === idCheck2) {
        DesmarcarCheckBoxExecutandoChange(idCheck1);
        DesmarcarCheckBoxExecutandoChange(idCheck3);
    }
    else if (idClicado === idCheck3) {
        DesmarcarCheckBoxExecutandoChange(idCheck1);
        DesmarcarCheckBoxExecutandoChange(idCheck2);
    }
}