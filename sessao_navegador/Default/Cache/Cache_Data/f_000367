function AdicionarPecaSemCadastro() {
    DesabilitarBotao('btnAdicionarPecasNova', 'Adicionando . . .');

    const quantidade = FormatarDinheiroParaDecimal($('#txtQuantidadePecaNova').val());
    const descricao = $('#txtDescricaoPeca').val();

    if (isNaN(quantidade) || quantidade <= 0) {
        HabilitarBotao('btnAdicionarPecasNova', 'Adicionar');
        return MostrarModalErro('quantidade', 'txtQuantidadePecaNova');
    }

    if (IsNullOrEmpty(descricao)) {
        HabilitarBotao('btnAdicionarPecasNova', 'Adicionar');
        return MostrarModalErro('descrição', 'txtDescricaoPeca');
    }

    const objeto = {
        quantidade: quantidade,
        descricao: descricao,
        unidade_medida: "", 
        id_peca_ordem: 0,
        id_ordem: ObterValorInput(ID_ORDEM), 
        id_peca_lizy: null, 
        reutilizar_peca: false,
        cliente_fornece: false,
        valor_unitario: 0,
        valor_total: 0
    };

    $.ajax({
        data: JSON.stringify(objeto),
        type: "POST",
        url: "/PecasOrdem/AdicionarPecasDaOrdem",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            HabilitarBotao('btnAdicionarPecasNova', 'Adicionar');

            if (response.erro) {
                swal("Ops!", response.mensagem, "warning");
            } else {
                swal("Sucesso", "Peça adicionada com sucesso", "success");
                $('#modal-nova-peca').modal('hide');
                $('#txtQuantidadePecaNova').val('');
                $('#txtDescricaoPeca').val('');
                ObterPecasDaOrdem(); 
                AtualizarValoresOrcamento();
            }
        },
        error: function () {
            HabilitarBotao('btnAdicionarPecasNova', 'Adicionar');
            swal("Erro", "Não foi possível adicionar a peça", "error");
        }
    });
}



function ValidarCamposPecaOrdem() {
  
    if (parseFloat($('#txtQuantidadePeca').val().replace(',', '.')) <= 0) return MostrarModalErro('quantidade', 'txtQuantidadePeca');
    if (IsNullOrEmpty($('#selectPecasOrdem option:selected').text())) return MostrarModalErroSelect('descrição', 'selectPecasOrdem');
    if (IsNullOrEmpty($('#txtUnidadeMedida').val())) return MostrarModalErro('unidade de medida', 'txtUnidadeMedida');
    if (IsNullOrEmpty($('#txtValorPecaUnitario').val())) return MostrarModalErro('valor unitário', 'txtValorPecaUnitario');
    if (IsNullOrEmpty($('#txtValorPeca').val())) return MostrarModalErro('valor total', 'txtValorPeca');

    return true;
}

function VerificaValorDeVenda(valorVenda, valorUnitario) {
