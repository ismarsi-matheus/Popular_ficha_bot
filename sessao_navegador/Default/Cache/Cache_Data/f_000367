function IncluirPecasDaOrdem() {

    if (!ValidarCamposPecaOrdem()) {
        return;
    }

    const quantidade = FormatarDinheiroParaDecimal(ObterValorInput(ID_ELEMENTO_QUANTIDADE_PECA_DA_ORDEM_ADICIONAR));
    const descricao = $('#selectPecasOrdem option:selected').text();
    const idPecaLizy = $('#selectPecasOrdem option:selected').attr('id');
    const unidadeMedida = ObterValorInput(ID_ELEMENTO_UNIDADE_DE_MEDIDA_PECA_DA_ORDEM);
    const valorUnitario = ObterValorInput(ID_ELEMENTO_VALOR_A_VISTA_PECA_DA_ORDEM);
    const valorTotal = ObterValorInput(ID_ELEMENTO_VALOR_TOTAL_PECA_DA_ORDEM);
    const porcentagemIcms = $('#selectPecasOrdem option:selected').attr('porcentagem_icms');
    const porcentagemIpi = $('#selectPecasOrdem option:selected').attr('porcentagem_ipi');
    let adicionadaAposAprovacao = false;

    const sku = $('#selectPecasOrdem option:selected').attr('sku');
    if (PaginaAtivaEh('FilaAprovados') || PaginaAtivaEh('FilaFinalizados'))
        adicionadaAposAprovacao = true;


    const objeto = GerarObjetoPecasDaOrdem(quantidade, descricao, unidadeMedida, valorUnitario, valorTotal, idPecaLizy, porcentagemIcms, porcentagemIpi, adicionadaAposAprovacao, sku);
    AdicionarPecasDaOrdem(objeto);
}


function GerarObjetoPecasDaOrdem(quantidade, descricao, unidadeMedida, valorUnitario, valorTotal, idPecaLizy, porcentagemIcms, porcentagemIpi, adicionadaAposAprovacao, sku) {
    return {
        "quantidade": quantidade,
        "descricao": descricao,
        "unidade_de_medida": unidadeMedida,
        "id_peca_ordem": 0,
        "id_ordem": ObterValorInput(ID_ORDEM),
        "id_peca_lizy": idPecaLizy,
        "reutilizar_peca": false,
        "cliente_fornece": false,
        "valor_unitario": FormatarDinheiroParaDecimal(valorUnitario),
        "valor_total": FormatarDinheiroParaDecimal(valorTotal),
        "porcentagem_icms": porcentagemIcms,
        "porcentagem_ipi": porcentagemIpi,
        "adicionada_pos_aprovacao": adicionadaAposAprovacao,
        "referencial_sku": sku
    };
}


function AdicionarPecasDaOrdem(objeto, buscarServicosDaOrdem = true) {

    $.ajax({
        data: JSON.stringify(objeto),
        type: "POST",
        url: "/PecasOrdem/AdicionarPecasDaOrdem",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (response.erro)
                swal("Ops!", response.mensagem, "warning");
            else {
                if (buscarServicosDaOrdem) {
                    swal("Sucesso", "Adicionado com sucesso", "success");

                    LimparCamposAdicionarPecasDaOrdem();
                    ObterPecasDaOrdem();
                    AtualizarValoresOrcamento();
                }
            }
        }
    });
}

function LimparCamposAdicionarPecasDaOrdem() {

    LimparInput(ID_ELEMENTO_QUANTIDADE_PECA_DA_ORDEM_ADICIONAR, 'txtQuantidadePeca');
    LimparInput(ID_ELEMENTO_UNIDADE_DE_MEDIDA_PECA_DA_ORDEM, 'txtUnidadeMedida');
    LimparInput(ID_ELEMENTO_VALOR_A_VISTA_PECA_DA_ORDEM, 'txtValorPecaUnitario');
    LimparInput(ID_ELEMENTO_VALOR_TOTAL_PECA_DA_ORDEM, 'txtValorPeca');
    ResetSelectPicker(ID_ELEMENTO_DESCRICAO_PECA_DA_ORDEM);
    HabilitarBotao('btnAdicionarPeca', 'Adicionar');
}

function ObterValorVendaTotalPecas() {
    let valorFormatado = $('#valorTotalComImposto').text(); 
    return FormatarDinheiroParaDecimal(valorFormatado);
}


