function CarregarObjetoJsonPecasOrdem() {
    var pecasOrdem = [];
    var rowsData = tabelaPecas.rows().data();

    for (var i = 0; i < rowsData.length; i++) {
        var valorVenda = 0;
        let idPecaOrdem = rowsData[i][INDEX_COLUNA_ID_LINHA];

        let quantidade = FormatarDinheiroParaDecimal(rowsData[i][_indexColunaQuantidade])
        let valorUnitario = FormatarDinheiroParaDecimal(rowsData[i][_indexColunaValorUnitario])
        let valorTotalCusto = FormatarDinheiroParaDecimal(rowsData[i][INDEX_COLUNA_VALOR_CUSTO_TOTAL])

        if (valorTotalCusto <= 0)
            valorTotalCusto = valorUnitario * quantidade;


        valorVenda = FormatarDinheiroParaDecimal(rowsData[i][_indexColunaValorVenda]);

        pecasOrdem.push({
            "quantidade": quantidade,
            "descricao": rowsData[i][_indexColunaDescricaoPeca],
            "unidade_de_medida": rowsData[i][INDEX_COLUNA_UNIDADE_MEDIDA],
            "reutilizar_peca": ObterValorCheckBox(PREFIXO_ELEMENTO_CHECKBOX_REUTILIZAR_PECA + idPecaOrdem),
            "cliente_fornece": ObterValorCheckBox(PREFIXO_ELEMENTO_CHECKBOX_CLIENTE_FORNECE + idPecaOrdem),
            "valor": valorTotalCusto,
            "margem_lucro": FormatarDinheiroParaDecimal(rowsData[i][INDEX_COLUNA_MARGEM_LUCRO]),
            "valor_venda": FormatarDinheiroParaDecimal(valorVenda),
            "descricao_orcamento": rowsData[i][_indexColunaDescricaoPecaOrcamento],
            "id_peca_lizy": rowsData[i][_indexColunaIDPeca],
            "alterar_campos_orcamento": MenuOrcamentoAtivo(),
            "conferido_por": rowsData[i][INDEX_COLUNA_CONFERIDO_POR_TABELA_PECAS_ORDEM],
            "data_conferencia": FormatarDataParaCSharp(rowsData[i][INDEX_COLUNA_DATA_CONFERENCIA_TABELA_PECAS_ORDEM]),
            "adicionada_pos_aprovacao": rowsData[i][INDEX_COLUNA_ADICIONADO_POS_APROVACAO_TABELA_PECAS_ORDEM],
        });
    }


    return pecasOrdem;
}

function AddInput(elmemento, campoDinheiro, campoQuantidade) {
    if (elmemento.getElementsByTagName('input').length > 0) return;

    _valorAntesEdicao = elmemento.innerHTML;
    elmemento.innerHTML = '';

    var input = document.createElement('input');
    input.setAttribute('type', 'text');
    input.setAttribute('id', 'inputEditando');
    input.setAttribute('class', 'editando');
    input.setAttribute('style', 'width:100%');
    input.setAttribute('onBlur', 'CloseInput(this,' + campoDinheiro + ')');
    input.setAttribute('onkeyup', 'enterVerify(event)');
    elmemento.appendChild(input);
    input.focus();
    //if (campoDinheiro) $('#inputEditando').mask('9999999999999999', { reverse: true });
    //else
    if (campoQuantidade) $('#inputEditando').mask('00000');

    $('#inputEditando').val('');
}

function CloseInput(elmemento, campoDinheiro) {
    var td = elmemento.parentNode;
    var value = elmemento.value;
    td.removeChild(elmemento);
    var cell = tabelaPecas.cell(td);
    if (_valorAntesEdicao !== value && value !== "") {

        if (!campoDinheiro) {
            td.innerHTML = value;
            cell.data(value);
        }
        else {
            var valor = FormatDinheiro(parseFloat(value.replace(',', '.')));

            if (!AlterouValorMargemLucro() && !AlterouQuantidade()) {
                valor = 'R$' + valor;
            }

            td.innerHTML = valor;
            cell.data(valor);
        }

        CalcularValorTotalPecas();
    }
    else td.innerHTML = _valorAntesEdicao;

    _valorAntesEdicao = '';
}

function CalcularValorTotalPecas() {
    let rowsData = tabelaPecas.rows().data();
    let totalVenda = 0;
    let totalCusto = 0;

    for (var i = 0; i < rowsData.length; i++) {

        let idLinha = rowsData[i][INDEX_COLUNA_ID_LINHA];
        let indexLinha = tabelaPecas.row('#' + idLinha).index();
        let quantidade = FormatarDinheiroParaDecimal(rowsData[i][_indexColunaQuantidade]);
        let valorUnitario = FormatarDinheiroParaDecimal(rowsData[i][_indexColunaValorUnitario])
        let valorVenda = FormatarDinheiroParaDecimal(rowsData[i][_indexColunaValorVenda]);
        let margemLucro = FormatarDinheiroParaDecimal(rowsData[i][INDEX_COLUNA_MARGEM_LUCRO]);
        let valorTotal = FormatarDinheiroParaDecimal(rowsData[i][INDEX_COLUNA_VALOR_CUSTO_TOTAL]);
        let valorTotalCalculado = FormatarDinheiroParaDecimal(valorUnitario * quantidade);
        let margemLucroCalculada = FormatarDinheiroParaDecimal(valorTotalCalculado * margemLucro);

        if (ObterValorCheckBox(PREFIXO_ELEMENTO_CHECKBOX_CLIENTE_FORNECE + idLinha) || ObterValorCheckBox(PREFIXO_ELEMENTO_CHECKBOX_REUTILIZAR_PECA + idLinha)) {
            tabelaPecas.cell({ row: indexLinha, column: _indexColunaValorUnitario }).data('R$' + FormatDinheiro(0));
            tabelaPecas.cell({ row: indexLinha, column: INDEX_COLUNA_VALOR_CUSTO_TOTAL }).data('R$' + FormatDinheiro(0));
            tabelaPecas.cell({ row: indexLinha, column: _indexColunaValorVenda }).data('R$' + FormatDinheiro(0));
        }


        if (AlterouValorUnitarioOuQuantidade()) {

            if (quantidade > 0 && valorUnitario > 0) {

                if (valorTotalCalculado !== valorTotal) {
                    tabelaPecas.cell({ row: indexLinha, column: INDEX_COLUNA_VALOR_CUSTO_TOTAL }).data('R$' + FormatDinheiro(valorTotalCalculado));
                }
                if (margemLucroCalculada !== valorVenda) {
                    tabelaPecas.cell({ row: indexLinha, column: _indexColunaValorVenda }).data('R$' + FormatDinheiro(margemLucroCalculada));
                }

            }
        }
        else if (AlterouValorTotal()) {
            margemLucroCalculada = FormatarDinheiroParaDecimal(valorTotal * margemLucro);

            if (quantidade > 0 && valorTotal > 0) {
                let valorUnitarioCalculado = FormatarDinheiroParaDecimal(valorTotal / quantidade);

                if (valorUnitarioCalculado !== valorUnitario) {
                    tabelaPecas.cell({ row: indexLinha, column: _indexColunaValorUnitario }).data('R$' + FormatDinheiro(valorUnitarioCalculado * margemLucro));
                }
            }

            if (margemLucroCalculada !== valorVenda) {
                tabelaPecas.cell({ row: indexLinha, column: _indexColunaValorVenda }).data('R$' + FormatDinheiro(margemLucroCalculada));
            }
        }
        else if (AlterouValorTotalVenda()) {
            margemLucroCalculada = margemLucroCalculada / valorTotalCalculado;
            tabelaPecas.cell({ row: indexLinha, column: INDEX_COLUNA_MARGEM_LUCRO }).data('R$' + FormatDinheiro(margemLucroCalculada));
        }

        if (margemLucro > 0 && !AlterouValorTotalVenda()) {
            if (margemLucroCalculada !== valorVenda && margemLucroCalculada > 0) {
                tabelaPecas.cell({ row: indexLinha, column: _indexColunaValorVenda }).data('R$' + FormatDinheiro(margemLucroCalculada));
            }
        }

        totalCusto += FormatarDinheiroParaDecimal(rowsData[i][INDEX_COLUNA_VALOR_CUSTO_TOTAL]);
        totalVenda += FormatarDinheiroParaDecimal(rowsData[i][_indexColunaValorVenda]);

        CalcularValorTotalCusto();
        CalcularValorTotalVenda();
    }

    RenderizarDatatable(tabelaPecas);

    $('#valorTotalPecas').text('R$' + FormatDinheiro(totalVenda));
    $('#valorTotalCustosPecas').text('R$' + FormatDinheiro(totalCusto));
}

