    if (PaginaAtivaEh('FilaAprovados')) {
        html += '<a href="javascript:void(0);" data-toggle="tooltip" title="Requisitar Peça" id="btnRequisitarPeca_' + _idColunaAtual + '" onclick="RequisitarPeca(' + _idColunaAtual + '); " class="btn btn-link btn-info btn-just-icon edit">' +
            '<i class="fas fa-file-download"></i>' +
            '</a>';
    }

    html += '<a href="javascript:void(0);" onclick="ExcluirPeca(' + _idColunaAtual + '); " class="btn btn-link btn-warning btn-just-icon edit">' +
        '<i class="material-icons">clear</i>' +
        '</a>';


    return html;
}


function RequisitarPeca(idPecaOrdem) {
    var attr = $('#btnRequisitarPeca_' + idPecaOrdem).attr('disabled');

    if (typeof attr !== typeof undefined && attr !== false) return;

    $('#btnRequisitarPeca_' + idPecaOrdem).attr("disabled", "disabled");
    $('#btnRequisitarPeca_' + idPecaOrdem).removeClass("btn-info");

    $.ajax({
        url: "/Pecas/RequisitarPeca/" + idPecaOrdem,
        type: "PUT",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (response.erro) {
                swal("Ops!", "Houve um erro ao requisitar peça. Detalhes: " + response.mensagem, "error");
                $('#btnRequisitarPeca_' + idPecaOrdem).addClass("btn-info");
                $('#btnRequisitarPeca_' + idPecaOrdem).removeAttr("disabled");
            }
            else {
                $('#btnRequisitarPeca_' + idPecaOrdem).remove();
                swal("Sucesso!", "Peça requisitada com sucesso", "success")
                    .then(okay => {
                    });
            }
        }
    });
}
