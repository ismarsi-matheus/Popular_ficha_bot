$("#btnAdicionar").click(function () {
    _idPecaEditando === 0 ? AdicionarCadastroPeca() : AlterarPeca();
});

function AdicionarPeca() {
    DesabilitarBotao('btnAdicionarPeca', 'Adicionando . . .');

    if (!ValidarCamposPecaOrdem()) {
        HabilitarBotao('btnAdicionarPeca', 'Adicionar');
        return;
    }
    _idColunaAtual = Math.floor(Math.random() * 1000);
    InserirPecaNaTabela();

    CalcularValorTotalCusto();
}

function ValidarCamposPecaOrdem() {
    if (IsNullOrEmpty($('#txtQuantidadePeca').val())) return MostrarModalErro('quantidade', 'txtQuantidadePeca');
    if (IsNullOrEmpty($('#selectPecasOrdem option:selected').text())) return MostrarModalErroSelect('descrição', 'selectPecasOrdem');

    return true;
}

function VerificaValorDeVenda(valorVenda, valorUnitario) {
    if (valorVenda === 0 || valorVenda === null)
        return valorUnitario;
    else
        return valorVenda;
}

function CalcularMargemLucro(valorVenda, valorUnitarioPeca) {
    if (valorVenda === 0)
        valorVenda = valorUnitarioPeca;

    var margemLucro = valorVenda / valorUnitarioPeca;

    return margemLucro;
}


function InserirPecaNaTabela() {
    let quantidade = ObterValorCampoFormatado('txtQuantidadePeca');
    var valorUnitarioPeca = ObterValorCampoFormatado('txtValorPecaUnitario');
    var valorPeca = quantidade * valorUnitarioPeca;
    var descricacaoPeca = $('#selectPecasOrdem option:selected').text();
    var idPeca = $('#selectPecasOrdem option:selected').attr('id');
    var unidadeMedida = ObterValorInput('txtUnidadeMedida');
    var valorVenda = ObterValorCampoFormatado('txtValorVenda');
    var margemLucro = calcularMarkup(+valorPeca, valorVenda);
    var adicionadoPosAprovacao = false;

    if (PaginaAtivaEh('FilaAprovados') || PaginaAtivaEh('FilaFinalizados')) {
        adicionadoPosAprovacao = true;
    }
    else {
        adicionadoPosAprovacao = false;
    }

    if (PaginaAtivaEh('Aprovados')) {
        valorUnitarioPeca = 0;
        valorPeca = 0;
        valorVenda = 0;
        margemLucro = 0;
    }

    if (PaginaAtivaEh('FilaAprovados')) {

        const peca = {
            "quantidade": FormatarDinheiroParaDecimal($('#txtQuantidadePeca').val()),
            "descricao": descricacaoPeca,
            "unidade_de_medida": unidadeMedida,
            "reutilizar_peca": false,
            "cliente_fornece": false,
            "valor": FormatarDinheiroParaDecimal(FormatDinheiro(valorPeca)),
            "margem_lucro": FormatarDinheiroParaDecimal(FormatDinheiro(margemLucro)),
            "valor_venda": FormatarDinheiroParaDecimal(FormatDinheiro(VerificaValorDeVenda(valorVenda, valorPeca))),
            "descricao_orcamento": descricacaoPeca.split(" ")[0],
            "id_peca": null,
            "id_peca_lizy": idPeca,
            "alterar_campos_orcamento": MenuOrcamentoAtivo(),
            "conferido_por": '',
            "data_conferencia": '',
            "adicionada_pos_aprovacao": adicionadoPosAprovacao,
        };

        AdicionarPecaRequest(peca, valorUnitarioPeca);
    }
    else {
        tabelaPecas.row.add([
        quantidade,
            descricacaoPeca,
            unidadeMedida,
            CriarCheckBoxReutilizarPeca(_idColunaAtual),
            CriarCheckBoxClienteFornecePeca(_idColunaAtual),
            'R$' + FormatDinheiro(valorUnitarioPeca),
            'R$' + FormatDinheiro(valorPeca),
        FormatDinheiro(+margemLucro),
            descricacaoPeca.split(" ")[0],
            'R$' + FormatDinheiro(VerificaValorDeVenda(valorVenda, valorPeca)),
            CriarFuncoesTabelaPecas(_idColunaAtual),
            idPeca,
            _idColunaAtual,
            '',
            '',
            adicionadoPosAprovacao

        ]).node().id = _idColunaAtual;

        RenderizarDatatable(tabelaPecas);

        LimparCamposPeca();

        if (!IsNullOrEmpty(valorPeca)) CalcularValorTotalPecas();

        HabilitarBotao('btnAdicionarPeca', 'Adicionar');
    }
}

function AdicionarPecaRequest(pecaOrdem, valorUnitario) {

    const idOrdem = ObterValorInput('txtIdOrdem')

    if (IsNullOrEmpty(idOrdem))
        return;

    $.ajax({
        url: "/Ordem/AdicionarPecaOrdem/" + idOrdem,
        type: "POST",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        data: JSON.stringify(pecaOrdem),
        success: function (response) {

            HabilitarBotao('btnAdicionarPeca', 'Adicionar');

            if (response.erro)
                return;

            const idPecaOrdemCriada = response.id
            _idColunaAtual = idPecaOrdemCriada;

            tabelaPecas.row.add([
                pecaOrdem.quantidade,
                pecaOrdem.descricao,
                pecaOrdem.unidade_de_medida,
                CriarCheckBoxReutilizarPeca(idPecaOrdemCriada),
                CriarCheckBoxClienteFornecePeca(idPecaOrdemCriada),
                'R$' + FormatDinheiro(valorUnitario),
                'R$' + FormatDinheiro(pecaOrdem.valor),
                FormatDinheiro(pecaOrdem.margem_lucro),
                pecaOrdem.descricao.split(" ")[0],
                'R$' + FormatDinheiro(VerificaValorDeVenda(pecaOrdem.valor_venda, pecaOrdem.valor)),
                CriarFuncoesTabelaPecas(idPecaOrdemCriada),
                0,
                idPecaOrdemCriada,
                '',
                '',
                pecaOrdem.adicionada_pos_aprovacao
            ]).node().id = idPecaOrdemCriada;

            RenderizarDatatable(tabelaPecas);

            LimparCamposPeca();

            if (!IsNullOrEmpty(pecaOrdem.valor)) CalcularValorTotalPecas();

        }
    });

}

function calcularMarkup(valorCusto, valorVenda) {
    // Evita divisão por zero e custo = 0
    if (valorCusto === 0) {
        return 0;
    }

    return (valorVenda / valorCusto).toFixed(2);
}



function CriarFuncoesTabelaPecas() {
