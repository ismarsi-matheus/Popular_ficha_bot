function printPageArea(areaID, tituloGrupo) {

    $('#btnImprimirGrupoFicha_' + areaID).attr('disabled', 'disabled');
    $('#btnImprimirGrupoFicha_' + areaID).css('color', '#ccc');

    $("#groupRow" + areaID).css('padding-top', '20px');

    $('#btnImprimirGrupoFicha_' + areaID).text('Gerando arquivo...');

    let numeroOrdem = $('#txtNumeroOrdem').val();

    setTimeout(() => {

        $("#groupRow" + areaID + ' img').each(function () {
            $(this).css('height', '0px');
        });

        $("#groupRow" + areaID).prepend('<div class="col-md-12"><h3>' + tituloGrupo + " - NPA: " + numeroOrdem + '</h3></div>');

        $("#groupRow" + areaID + ' textarea').each(function () {
            if (!$(this).hasClass('d-none')) {

                let lines = $(this).val().split('\n');
                let linhasFormatadas = '';

                $.each(lines, function () {
                    linhasFormatadas += '<div>' + this + '</div>';
                });

                $(this).after("<div class='divTemporaria' contenteditable=\"true\" style='padding-top:10px'>" + linhasFormatadas + "</div>");
                $(this).addClass('d-none');
            }
        });

        html2canvas($("#groupRow" + areaID)[0]).then((canvas) => {

            theCanvas = canvas;

            $("#groupRow" + areaID).find('div:first').remove();

            canvas.toBlob(function (blob) {
                saveAs(blob, tituloGrupo + ".png");
                $("#groupRow" + areaID).css('padding-top', '0');
                $('#btnImprimirGrupoFicha_' + areaID).attr('disabled', 'false');
                $('#btnImprimirGrupoFicha_' + areaID).text('Imprimir');
                $('#btnImprimirGrupoFicha_' + areaID).css('color', '#009ef7');

                $("#groupRow" + areaID + ' img').each(function () {
                    $(this).css('height', 'unset');
                });

                $("#groupRow" + areaID + ' textarea').each(function () {
                    $(this).removeClass('d-none');
                });

                $("#groupRow" + areaID + ' div.divTemporaria').remove();
            });

        });
    }, 1000);
}

