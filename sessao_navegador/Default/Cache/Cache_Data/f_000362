function CalcularDiferencaEntreDatasEFormatarEmHorasMinutos(data1, data2) {

    var diferencaDatas = CriarObjetoDiferencaDatas();

    var duracao = moment.duration(data1.diff(data2));

    if (duracao < 0) diferencaDatas.negativo = true;

    var horasDiasDuracao = duracao._data.days * 24;
    var horasDuracao = duracao._data.hours;

    if (horasDiasDuracao < 0) horasDiasDuracao = horasDiasDuracao * -1;
    if (horasDuracao < 0) horasDuracao = horasDuracao * -1;

    var horasRestantes = horasDuracao + horasDiasDuracao;
    var minutosRestantes = duracao._data.minutes;

    if (minutosRestantes < 0) minutosRestantes = minutosRestantes * -1;

    minutosRestantes = FormataMinutosEHoras(minutosRestantes);
    horasRestantes = FormataMinutosEHoras(horasRestantes);

    diferencaDatas.horasMinutosRestantes = horasRestantes + ":" + minutosRestantes;

    return diferencaDatas;
}

function CriarObjetoDiferencaDatas() {

    return {
        "negativo": false,
        "horasMinutosRestantes": null
    }
}

