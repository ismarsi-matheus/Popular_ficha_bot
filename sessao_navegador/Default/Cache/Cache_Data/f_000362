function FormatarDinheiroParaDecimal(numero) {
    var valor = 0;

    if (IsNullOrEmpty(numero)) return 0;
    if (!IsNullOrEmpty(numero) && VariavelEhString(numero)) {
        numero = FormataStringParaFloatRemovendoCaracteresInvalidos(numero);
        valor = parseFloat(numero.replace(/\./g, '').replace(',', '.'));
    }
    else valor = parseFloat(numero);

    return valor;
}

// ---------------------------------------------------------------------------
// Exportação de valores monetários para Excel (DataTables Buttons / excelHtml5)
//
// O Buttons decide sozinho se uma célula é número ou texto olhando o padrão do
// texto exportado, e ele não entende o padrão pt-BR gerado por FormatDinheiro.
// Por isso a conversão é feita explicitamente aqui, e o formato de moeda é
// aplicado depois via customize().
// ---------------------------------------------------------------------------

// O ponto e a vírgula do formatCode são neutros: quem escolhe o separador
// exibido é a região do usuário. Em pt-BR sai "R$ 1.234,56".
const FORMATO_MONETARIO_EXCEL = '"R$ "#,##0.00';

// 164 a 169 já são usados pelo próprio DataTables Buttons.
const ID_FORMATO_MONETARIO_EXCEL = 170;

// Converte o texto exibido na tela ("1.234,56") para o texto que o Buttons
// reconhece como número ao montar a planilha ("1234.56").
function FormatarDinheiroParaCelulaExcel(textoDinheiro) {
    return FormatarDinheiroParaDecimal(textoDinheiro).toFixed(2);
}

// Posição da coluna (base 0) para a letra usada pelo Excel: 0 -> A, 26 -> AA.
function LetraColunaExcel(posicaoColuna) {

    var letra = '';
    var resto = posicaoColuna;

    while (resto >= 0) {
        letra = String.fromCharCode(65 + (resto % 26)) + letra;
        resto = Math.floor(resto / 26) - 1;
    }

    return letra;
}

function CriarElementoXml(documentoXml, nome, atributos) {

    // createElement puro geraria o nó fora do namespace do documento
    // (xmlns="" no XML final) e o Excel recusaria a planilha.
    var elemento = documentoXml.createElementNS(documentoXml.documentElement.namespaceURI, nome);

    Object.keys(atributos).forEach(function (chave) {
        elemento.setAttribute(chave, atributos[chave]);
    });

    return elemento;
}

// Registra o formato monetário no styles.xml da planilha e devolve o índice do
// estilo, que é o valor do atributo "s" das células. Idempotente: se o formato
// já foi registrado nesta planilha, devolve o índice existente.
function RegistrarEstiloMonetarioExcel(xlsx) {

    var estilos = xlsx.xl['styles.xml'];
    var estilosCelula = $('cellXfs', estilos);

    var estiloExistente = estilosCelula.children().filter(function () {
        return $(this).attr('numFmtId') === String(ID_FORMATO_MONETARIO_EXCEL);
    });

    if (estiloExistente.length > 0)
        return estiloExistente.index();

    var formatos = $('numFmts', estilos);

    formatos[0].appendChild(CriarElementoXml(estilos, 'numFmt', {
        numFmtId: ID_FORMATO_MONETARIO_EXCEL,
        formatCode: FORMATO_MONETARIO_EXCEL
    }));

    formatos.attr('count', formatos.children().length);

    estilosCelula[0].appendChild(CriarElementoXml(estilos, 'xf', {
        numFmtId: ID_FORMATO_MONETARIO_EXCEL,
        fontId: 0,
        fillId: 0,
        borderId: 0,
        applyFont: 1,
        applyFill: 1,
        applyBorder: 1,
        xfId: 0,
        applyNumberFormat: 1
    }));

    estilosCelula.attr('count', estilosCelula.children().length);

    return estilosCelula.children().length - 1;
}

// Aplica o formato monetário às células numéricas de uma coluna da planilha.
// posicaoColuna é a posição da coluna DENTRO do conjunto exportado (colunas
// ocultas não são exportadas e deslocam as demais).
function AplicarFormatoMonetarioNaColunaExcel(xlsx, posicaoColuna) {

    var planilha = xlsx.xl.worksheets['sheet1.xml'];
    var estilo = RegistrarEstiloMonetarioExcel(xlsx);
    var letra = LetraColunaExcel(posicaoColuna);

    // Título e cabeçalho saem como inlineStr (têm o atributo "t") e mantêm o
    // estilo original; só as células numéricas recebem o formato de moeda.
    $('row c', planilha).filter(function () {
        return $(this).attr('r').replace(/\d+$/, '') === letra
            && $(this).attr('t') === undefined;
    }).attr('s', estilo);
}

