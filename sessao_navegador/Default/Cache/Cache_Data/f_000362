function CalcularEFormatarTempoRestante(dataLimite) {

    var dadosTempoRestante = {
        diferenca_horas: "",
        diferenca_formatada: ""
    };

    if (!IsNullOrEmpty(dataLimite) && dataLimite !== '0001-01-01T00:00:00') {
        dadosTempoRestante = CalcularTempoRestante(dataLimite);
    }
    return dadosTempoRestante;
}

function CalcularTempoRestante(dataLimite) {

    var dataAtual = moment();
    var dataLimiteFormatada = moment(dataLimite);

    var duracao = moment.duration(dataLimiteFormatada.diff(dataAtual));

    var horasDias = duracao._data.days * 24;

    if (horasDias < 0)
        horasDias = horasDias * -1;

    var horasRestantes = duracao._data.hours + horasDias;
    var minutosRestantes = duracao._data.minutes;

    if (minutosRestantes < 0)
        minutosRestantes = minutosRestantes * -1;

    if (duracao._data.days < 0)
        horasRestantes = horasRestantes * -1;

    minutosRestantes = FormataMinutosEHoras(minutosRestantes);
    horasRestantes = FormataMinutosEHoras(horasRestantes);

    return CarregarObjetoTempoRestante(horasRestantes, horasRestantes + ":" + minutosRestantes);
}

function CalcularRestanteEmDias(dataLimite) {
    let dataAtualDias = new Date();

    let diasRestantes = moment(dataLimite).diff(moment(dataAtualDias));
    let dias = moment.duration(diasRestantes).asDays();

    let diasRestantesFormatada = Math.round(dias);

    return diasRestantesFormatada;
}

function CalcularTempoSetor(dataInicio) {

    if (IsNullOrEmpty(dataInicio)) {
        return '';
    }

    var dataAtual = moment();
    var dataInicioFormatada = moment(dataInicio);

    var duracao = moment.duration(dataAtual.diff(dataInicioFormatada));

    var horasDias = duracao._data.days * 24;

    if (horasDias < 0)
        horasDias = horasDias * -1;

    var horasRestantes = duracao._data.hours + horasDias;
    var minutosRestantes = duracao._data.minutes;

    if (minutosRestantes < 0) {
        minutosRestantes = minutosRestantes * -1;
    }

    if (duracao._data.days < 0)
        horasRestantes = horasRestantes * -1;

    minutosRestantes = FormataMinutosEHoras(minutosRestantes);
    horasRestantes = FormataMinutosEHoras(horasRestantes);

    return horasRestantes + ":" + minutosRestantes;
}

function RetornaClasseTempoOperacaoPlanejado(horasMinutosTrabalhados, horasMinutosPlanejadas) {

    if (IsNullOrEmpty(horasMinutosTrabalhados) && !IsNullOrEmpty(horasMinutosPlanejadas)) {
        return 'green-row';
    }

    if (IsNullOrEmpty(horasMinutosPlanejadas) && !IsNullOrEmpty(horasMinutosTrabalhados)) {
        return 'red-row';
    }

    if (IsNullOrEmpty(horasMinutosPlanejadas) && IsNullOrEmpty(horasMinutosTrabalhados)) {
        return "";
    }

    var trabalhados = horasMinutosTrabalhados.split(':');
    var planejados = horasMinutosPlanejadas.split(':');

    var horasTrabalhadas = parseInt(trabalhados[0]);
    var horasPlanejadas = parseInt(planejados[0]);

    var totalMinutosTrabalhados = (horasTrabalhadas * 60) + parseInt(trabalhados[1]);
    var totalMinutosPlanejados = (horasPlanejadas * 60) + parseInt(planejados[1]);

    if (totalMinutosTrabalhados >= totalMinutosPlanejados) {
        return 'red-row';
    }
    else {
        return 'green-row';
    }
}

var _corVermelha = '#F00';
var _corVerde = '#4caf50';
var _corAmarela = '#ffa726';

function RetornarCorTempoOperacaoPlanejado(horasMinutosTrabalhados, horasMinutosPlanejadas) {

    if (IsNullOrEmpty(horasMinutosTrabalhados) && !IsNullOrEmpty(horasMinutosPlanejadas)) {
        return _corVerde;
    }

    if (IsNullOrEmpty(horasMinutosPlanejadas) && !IsNullOrEmpty(horasMinutosTrabalhados)) {
        return _corVermelha;
    }

    if (IsNullOrEmpty(horasMinutosPlanejadas) && IsNullOrEmpty(horasMinutosTrabalhados)) {
        return "";
    }

    let trabalhados = horasMinutosTrabalhados.split(':');
    let planejados = horasMinutosPlanejadas.split(':');

    let horasTrabalhadas = parseInt(trabalhados[0]);
    let horasPlanejadas = parseInt(planejados[0]);

    let totalMinutosTrabalhados = (horasTrabalhadas * 60) + parseInt(trabalhados[1]);
    let totalMinutosPlanejados = (horasPlanejadas * 60) + parseInt(planejados[1]);

    if (totalMinutosTrabalhados >= totalMinutosPlanejados) {
        return _corVermelha;
    }
    else {
        return _corVerde;
    }
}

function FormatarDataParaCSharp(data) {

    if (IsNullOrEmpty(data)) return null;

    let dataFormatada = moment(data, 'DD/MM/YYYY').format('YYYY-MM-DD');
    let dataHoraFormatada = dataFormatada + " 00:00:00";

