function FormatDinheiro(numero) {
    //Verifica se o valor não está nulo, caso esteja retorna 0,00
    if (numero !== null && numero !== undefined) {
        numero = numero.toFixed(2).split('.');
        numero[0] = numero[0].split(/(?=(?:...)*$)/).join('.');
        return numero.join(',');
    }
    else {
        return "0,00";
    }
}

function FormatDinheiroInteligente(numero) {
    if (numero === null || numero === undefined) return "0,00";
    var casas = (Math.round(numero * 10000) % 100 !== 0) ? 4 : 2;
    var parts = numero.toFixed(casas).split('.');
    parts[0] = parts[0].split(/(?=(?:...)*$)/).join('.');
    return parts.join(',');
}

function FormatDinheiroPreciso(numero) {
    if (numero !== null && numero !== undefined) {
        numero = numero.toFixed(4).split('.');
        numero[0] = numero[0].split(/(?=(?:...)*$)/).join('.');
        return numero.join(',');
    }
    else {
        return "0,0000";
    }
}

function IsNullOrEmpty(value) {
    var result = false;

    if (!value || value == undefined || value == "" || value.length == 0 || value == "0" || value === "null" || value === null || value == " ") {
        result = true;
    }

    return result;
}

