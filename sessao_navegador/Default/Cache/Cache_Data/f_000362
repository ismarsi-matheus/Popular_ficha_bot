function AlterarStatusAguardandoCliente(idFila, callBackFunctionSucesso) {
    $.ajax({
        dataType: "json",
        data: {
            idFila: idFila,
        },
        type: "PUT",
        url: "/Fila/AlterarFilaAguardandoCliente/" + idFila,
        success: function (response) {
            if (!response.erro) {
                callBackFunctionSucesso();
            }
            else swal("Erro", "Houve um erro ao alterar status: " + response.mensagem, "error");
        }
    });
}

function ObterLinkDownloadFormatado(linkArquivo) {
    if (linkArquivo.includes("empowcdn.blob.core.windows.net"))
        return linkArquivo;

    var caminhoCDN = linkArquivo.split("/Arquivos")[0];

    var nomeArquivo = linkArquivo.split('/')[linkArquivo.split('/').length - 1];

    if (!IsNullOrEmpty(caminhoCDN) && !IsNullOrEmpty(nomeArquivo))
        return caminhoCDN + "/api/DownloadArquivo?nomeArquivo=" + nomeArquivo;
    else
        return "";
}

function ObterApenasNumeroDaString(string) {
    var valor = 0;
    if (IsNullOrEmpty(string)) return 0;
    if (!IsNullOrEmpty(string) && VariavelEhString(string)) {
        let numsStr = string.replace(/[^0-9]/g, '');
        valor = parseFloat(numsStr);
    }
    else valor = parseFloat(string);
    return valor;
}

