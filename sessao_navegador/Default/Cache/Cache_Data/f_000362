function AddInputDataPrevistaEntrega(elemento, idOrdem, dataFim) {
    if (elemento.getElementsByTagName('input').length > 0) return;

    _valorAntesEdicao = dataFim;
    elemento.innerHTML = '';

    var input = document.createElement('input');
    input.setAttribute('type', 'text');
    input.setAttribute('id', 'inputEditando');
    input.setAttribute('class', 'editando');
    input.setAttribute('style', 'width:100%');
    input.setAttribute('onBlur', 'CloseInputDataPrevistaEntrega(this,' + idOrdem + ')');
    input.setAttribute('onkeyup', 'enterVerify(event)');
    elemento.appendChild(input);
    input.focus();
    $('#inputEditando').mask('00/00/0000');

    $('#inputEditando').val(_valorAntesEdicao);
}

var novaDataEntrega = '';
var idOrdemAlterandoDataEntrega = '';
var justificativaObter = '';

function AbrirModalJustificativa(dataEntrega, idOrdem) {
    $('#justificationModal').modal('show');
    LimparInput('txtjustificationInput');

    novaDataEntrega = dataEntrega;
    idOrdemAlterandoDataENtrega = idOrdem;
}

function ValorDataEhValido(valorHora) {
    return moment(valorHora, "DD/MM/YYYY", true).isValid()
}

function AlterarDataEntregaRequest() {
    let idOrdem = idOrdemAlterandoDataENtrega;
    let data = { data_prevista: novaDataEntrega, observacao: '' };

    $.ajax({
        data: JSON.stringify(data),
        url: "/Tarefa/AlterarDataPrevistaEntrega/" + idOrdem,
        type: "PUT",
        contentType: "application/json; charset=utf-8",
        dataType: "json",

        success: function (response) {
            AtualizarDadosPagina();
        }
    });
}

function CloseInputDataPrevistaEntrega(elemento, idOrdem) {
    var td = elemento.parentNode;
    var value = elemento.value;
    td.removeChild(elemento);
    if (_valorAntesEdicao !== value) {
        td.innerHTML = value;

        if (IsNullOrEmpty(value)) {

            AtualizarDadosPagina();
            return;
        }

        if (!ValorDataEhValido(value)) {

            AtualizarDadosPagina();
            return;
        }

        value = FormatarDataParaCSharp(value);

        novaDataEntrega = value;
        idOrdemAlterandoDataENtrega = idOrdem;
        AlterarDataEntregaRequest();
    }
    else
        AtualizarDadosPagina();

    _valorAntesEdicao = '';
}

